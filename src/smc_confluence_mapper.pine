indicator("SMC Confluence Mapper", shorttitle = "SMC-CM", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500, max_bars_back = 1000)

// ─────────────────────────────────────────────────────────────────────────────
// Inputs
// ─────────────────────────────────────────────────────────────────────────────
G_MS  = "Market Structure"
G_OB  = "Order Blocks"
G_FVG = "Fair Value Gaps"
G_LIQ = "Liquidity (BSL / SSL)"
G_KZ  = "Killzones"
G_CDL = "Candlestick Patterns"
G_FIB = "Fibonacci & Premium / Discount"
G_ENT = "Entry Rules & Confluence"
G_ORD = "Order Execution & Trade Management"
G_HTF = "Higher-Timeframe Bias"
G_STY = "Style"
G_DSH = "Dashboard"

swingLen     = input.int(5, "Swing length", minval = 2, maxval = 50, group = G_MS, tooltip = "Bars on each side needed to confirm a swing high / low. Higher values give fewer, more significant swings.")
breakSrc     = input.string("Close", "Break confirmation", options = ["Close", "Wick"], group = G_MS, tooltip = "Close: a candle must CLOSE beyond the swing to count as a break. Wick: any trade beyond the swing counts.")
showSwings   = input.bool(true, "Label swings (HH / HL / LH / LL)", group = G_MS)
showStruct   = input.bool(true, "Show BOS / CHoCH", group = G_MS)

showOB       = input.bool(true, "Show order blocks", group = G_OB)
obRangeType  = input.string("Wick", "Order block range", options = ["Wick", "Body"], group = G_OB)
obMaxAtr     = input.float(2.0, "Max OB height (× ATR)", minval = 0.2, maxval = 10.0, step = 0.1, group = G_OB, tooltip = "Taller wick OBs are refined to the candle body. If the body is still taller, the OB is skipped as low quality.")
obNeedDisp   = input.bool(true, "Require displacement after the OB", group = G_OB, tooltip = "The move away from the OB must leave a fair value gap or a strong candle (body > 1.5 × average). Filters weak OBs.")
obMax        = input.int(3, "Max active OBs per side", minval = 1, maxval = 20, group = G_OB)
obScan       = input.int(150, "Max bars scanned for the OB candle", minval = 10, maxval = 500, group = G_OB)
obKeepBroken = input.bool(false, "Keep invalidated OBs (greyed out)", group = G_OB)

showFVG      = input.bool(true, "Show fair value gaps", group = G_FVG)
fvgMinAtr    = input.float(0.3, "Minimum gap size (× ATR)", minval = 0.0, maxval = 5.0, step = 0.05, group = G_FVG)
fvgMitigation = input.string("50% (CE)", "Remove FVG when", options = ["50% (CE)", "Full fill"], group = G_FVG, tooltip = "50% (CE): removed once price trades through the consequent encroachment (midpoint). Full fill: removed only when the whole gap is filled.")
fvgMax       = input.int(3, "Max active FVGs per side", minval = 1, maxval = 30, group = G_FVG)

showLiq      = input.bool(true, "Show liquidity pools (BSL / SSL)", group = G_LIQ, tooltip = "Buy-side liquidity rests above swing highs, sell-side below swing lows. Equal highs / lows (EQH / EQL) are the strongest pools.")
liqMax       = input.int(3, "Pools tracked per side", minval = 1, maxval = 15, group = G_LIQ)
eqTolAtr     = input.float(0.1, "Equal highs / lows tolerance (× ATR)", minval = 0.0, maxval = 1.0, step = 0.01, group = G_LIQ)
sweepMemory  = input.int(3, "Sweep stays valid for (bars)", minval = 0, maxval = 50, group = G_LIQ)
showSweeps   = input.bool(true, "Mark liquidity sweeps", group = G_LIQ)

useKZ        = input.bool(false, "Count killzone timing as a factor", group = G_KZ)
showKZ       = input.bool(false, "Shade killzones", group = G_KZ)
kzTz         = input.string("America/New_York", "Killzone timezone", group = G_KZ)
kzLondon     = input.session("0200-0500", "London killzone", group = G_KZ)
kzNY         = input.session("0700-1000", "New York killzone", group = G_KZ)

candleMode   = input.string("At POI only", "Label candlestick patterns", options = ["All", "At POI only", "Off"], group = G_CDL, tooltip = "At POI only: label patterns only when price is at an order block, FVG, golden zone or has just swept liquidity.")
cdlTrendOnly = input.bool(true, "Only label trend-aligned patterns", group = G_CDL)
useEngulf    = input.bool(true, "Engulfing", group = G_CDL, inline = "c1")
usePin       = input.bool(true, "Hammer / Shooting star", group = G_CDL, inline = "c1")
useStar      = input.bool(true, "Morning / Evening star", group = G_CDL, inline = "c2")
useHarami    = input.bool(true, "Harami", group = G_CDL, inline = "c2")
useTweezer   = input.bool(true, "Tweezer top / bottom", group = G_CDL, inline = "c3")
useThree     = input.bool(true, "3 Soldiers / 3 Crows", group = G_CDL, inline = "c3")
useMarubozu  = input.bool(true, "Marubozu", group = G_CDL, inline = "c4")
usePiercing  = input.bool(true, "Piercing / Dark cloud", group = G_CDL, inline = "c4")
useDoji      = input.bool(true, "Dragonfly / Gravestone doji", group = G_CDL, inline = "c5")

showFib      = input.bool(true, "Draw Fibonacci on the current leg", group = G_FIB)
gzStart      = input.float(0.618, "Golden zone start", minval = 0.0, maxval = 1.0, step = 0.001, group = G_FIB)
gzEnd        = input.float(0.786, "Golden zone end", minval = 0.0, maxval = 1.0, step = 0.001, group = G_FIB)
extLevel     = input.float(0.272, "Extension beyond the leg", minval = 0.0, maxval = 3.0, step = 0.001, group = G_FIB, tooltip = "Used as TP2 when no liquidity pool lies beyond TP1.")
showPD       = input.bool(false, "Show premium / discount zones", group = G_FIB)

minScore     = input.int(4, "Minimum confluence score", minval = 1, maxval = 9, group = G_ENT)
reqTrend     = input.bool(true, "Require structure in the trade direction", group = G_ENT)
reqPOI       = input.bool(true, "Require a point of interest (OB / FVG / golden zone)", group = G_ENT)
reqCandle    = input.bool(true, "Require a confirmation candlestick pattern", group = G_ENT)
minRR        = input.float(1.5, "Minimum R:R to TP1", minval = 0.0, maxval = 20.0, step = 0.1, group = G_ENT)
slAtrBuf     = input.float(0.25, "Stop-loss buffer (× ATR)", minval = 0.0, maxval = 5.0, step = 0.05, group = G_ENT)
cooldown     = input.int(5, "Bars between signals (same side)", minval = 0, maxval = 200, group = G_ENT)
oneTrade     = input.bool(true, "One trade at a time", group = G_ENT, tooltip = "No new signal while a limit order is pending or a trade is open.")

entryMode    = input.string("Auto (market or limit)", "Order type", options = ["Auto (market or limit)", "Market only", "Limit only"], group = G_ORD, tooltip = "Auto: MARKET when the signal candle closes close to the optimal price and the R:R holds; otherwise a LIMIT order is placed back inside the zone.")
limitAt      = input.string("50% of zone", "Limit price inside zone", options = ["Proximal edge", "50% of zone", "OTE 0.705"], group = G_ORD, tooltip = "Proximal edge: first touch of the zone (more fills). 50% of zone: mean threshold of the OB / CE of the FVG. OTE 0.705: optimal trade entry on the leg.")
mktTolAtr    = input.float(0.3, "Market entry if close is within (× ATR) of limit", minval = 0.0, maxval = 5.0, step = 0.05, group = G_ORD)
limitExpiry  = input.int(10, "Limit order expires after (bars)", minval = 1, maxval = 200, group = G_ORD)
tp1MinR      = input.float(1.0, "TP1 must be at least (R) away", minval = 0.1, maxval = 10.0, step = 0.1, group = G_ORD, tooltip = "TP1 is the nearest liquidity pool / leg extreme at least this far from entry.")
tp1Pct       = input.int(50, "Close % at TP1", minval = 0, maxval = 100, group = G_ORD)
beAfterTp1   = input.bool(true, "Move SL to entry after TP1", group = G_ORD)
maxLife      = input.int(100, "Close trade after (bars)", minval = 5, maxval = 1000, group = G_ORD)
keepSetups   = input.int(3, "Finished trades kept on chart", minval = 0, maxval = 20, group = G_ORD)

useHtf       = input.bool(false, "Count higher-timeframe structure as a factor", group = G_HTF)
htfTf        = input.timeframe("240", "HTF timeframe", group = G_HTF, tooltip = "Should be higher than the chart timeframe.")
htfLen       = input.int(5, "HTF swing length", minval = 2, maxval = 50, group = G_HTF)

lineW        = input.int(1, "Line width", minval = 1, maxval = 4, group = G_STY)
txtSizeIn    = input.string("Tiny", "Label size", options = ["Tiny", "Small", "Normal"], group = G_STY)
zoneExtend   = input.int(10, "Extend zones right (bars)", minval = 0, maxval = 100, group = G_STY)
bullColor    = input.color(#089981, "Bullish", group = G_STY, inline = "s1")
bearColor    = input.color(#F23645, "Bearish", group = G_STY, inline = "s1")
obBullFill   = input.color(color.new(#089981, 90), "Bull OB", group = G_STY, inline = "s2")
obBearFill   = input.color(color.new(#F23645, 90), "Bear OB", group = G_STY, inline = "s2")
fvgBullFill  = input.color(color.new(#2962FF, 92), "Bull FVG", group = G_STY, inline = "s3")
fvgBearFill  = input.color(color.new(#FF9800, 92), "Bear FVG", group = G_STY, inline = "s3")
fibColor     = input.color(#9598A1, "Fib levels", group = G_STY, inline = "s4")
gzFill       = input.color(color.new(#FFD600, 90), "Golden zone", group = G_STY, inline = "s4")
slColor      = input.color(#F23645, "Stop loss", group = G_STY, inline = "s5")
tpColor      = input.color(#089981, "Take profit", group = G_STY, inline = "s5")
liqColor     = input.color(color.new(#B2B5BE, 25), "Liquidity", group = G_STY, inline = "s6")
txtCol       = input.color(color.white, "Text", group = G_STY, inline = "s6")

showDash     = input.bool(true, "Show dashboard", group = G_DSH)
dashPosIn    = input.string("Top right", "Position", options = ["Top right", "Top left", "Bottom right", "Bottom left"], group = G_DSH)
dashSizeIn   = input.string("Small", "Text size", options = ["Tiny", "Small", "Normal"], group = G_DSH)
showCard     = input.bool(true, "Show trade card", group = G_DSH, tooltip = "Side card with the latest setup: entry, stop loss and targets in price and pips, R:R, and why the trade was taken.")
cardPosIn    = input.string("Bottom right", "Trade card position", options = ["Top right", "Top left", "Bottom right", "Bottom left", "Middle right"], group = G_DSH)
pipSizeIn    = input.float(0.0, "Pip size (0 = auto)", minval = 0.0, step = 0.00001, group = G_DSH, tooltip = "Auto: forex 0.0001 (0.01 for JPY pairs), gold 0.1, everything else 1 tick. Set a value to override.")

lblSize  = txtSizeIn == "Tiny" ? size.tiny : txtSizeIn == "Small" ? size.small : size.normal
dashSize = dashSizeIn == "Tiny" ? size.tiny : dashSizeIn == "Small" ? size.small : size.normal
fvgCE    = fvgMitigation == "50% (CE)"
NOCOLOR  = color.new(color.black, 100)

// Pip size: forex 5/3-decimal quotes use 10 ticks per pip, gold 0.1, others 1 tick
pipSize() =>
    float mt = syminfo.mintick
    float p  = mt
    if pipSizeIn > 0
        p := pipSizeIn
    else if syminfo.type == "forex"
        int dec = int(math.round(math.log10(1 / mt)))
        p := dec == 3 or dec == 5 ? mt * 10 : mt
    else if str.contains(syminfo.ticker, "XAU")
        p := 0.1
    p
PIP = pipSize()

pips(float d) =>
    math.abs(d) / PIP

fmtPips(float d) =>
    str.tostring(pips(d), "#.#") + " pips"

// ─────────────────────────────────────────────────────────────────────────────
// Types
// ─────────────────────────────────────────────────────────────────────────────
type Zone
    float top
    float btm
    int   left
    int   created
    box   bx = na

type Pool
    float price
    int   left
    bool  eq = false
    line  ln = na
    label lb = na

type Trade
    int    dir
    bool   isMarket
    int    state
    int    startBar
    int    startTime
    int    fillBar
    float  entry
    float  sl
    float  slInit
    float  tp1
    float  tp2
    bool   tp1Hit  = false
    bool   filled  = false
    bool   counted = false
    float  result  = 0.0
    string outcome = ""
    int    score    = 0
    int    total    = 0
    string why      = ""
    string orderWhy = ""
    string slWhy    = ""
    string tpWhy    = ""
    box    bxRisk   = na
    box    bxReward = na
    line   lnEntry  = na
    line   lnSl     = na
    line   lnTp1    = na
    line   lnTp2    = na
    label  lbEntry  = na
    label  lbSl     = na
    label  lbTp1    = na
    label  lbTp2    = na

// ─────────────────────────────────────────────────────────────────────────────
// Zone methods (order blocks & FVGs)
// ─────────────────────────────────────────────────────────────────────────────
// Keep at most maxN zones (newest are at index 0).
method trim(array<Zone> zones, int maxN) =>
    while zones.size() > maxN
        Zone z = zones.pop()
        if not na(z.bx)
            z.bx.delete()

method overlaps(array<Zone> zones, float top, float btm) =>
    bool hit = false
    for z in zones
        if top >= z.btm and btm <= z.top
            hit := true
    hit

// Extend live zones, detect taps on this bar, remove invalidated zones.
// Returns [tapped, top of tapped zone, bottom of tapped zone].
method update(array<Zone> zones, bool bullish, bool isFvg, bool keepBroken) =>
    bool  tapped = false
    float tTop   = na
    float tBtm   = na
    int   n      = zones.size()
    if n > 0
        for i = n - 1 to 0
            Zone  z      = zones.get(i)
            float fvgLvl = fvgCE ? (z.top + z.btm) / 2 : (bullish ? z.btm : z.top)
            bool invalid = isFvg ? (bullish ? low <= fvgLvl : high >= fvgLvl) : (bullish ? close < z.btm : close > z.top)
            bool touch   = bar_index > z.created and (bullish ? (low <= z.top and close >= z.btm) : (high >= z.btm and close <= z.top))
            if touch
                tapped := true
                tTop   := z.top
                tBtm   := z.btm
            if invalid
                if not na(z.bx)
                    if keepBroken and not isFvg
                        z.bx.set_right(bar_index)
                        z.bx.set_bgcolor(color.new(color.gray, 92))
                        z.bx.set_border_color(color.new(color.gray, 80))
                        z.bx.set_text_color(txtCol)
                    else
                        z.bx.delete()
                zones.remove(i)
            else if not na(z.bx)
                z.bx.set_right(bar_index + zoneExtend)
    [tapped, tTop, tBtm]

// ─────────────────────────────────────────────────────────────────────────────
// Liquidity pool methods
// ─────────────────────────────────────────────────────────────────────────────
// Add a pool at a confirmed swing, or merge it into an existing one as EQH / EQL.
method addPool(array<Pool> pools, float px, int x, bool buySide, float tol) =>
    bool merged = false
    for p in pools
        if not merged and math.abs(p.price - px) <= tol
            p.eq    := true
            p.price := buySide ? math.max(p.price, px) : math.min(p.price, px)
            if not na(p.ln)
                p.ln.set_y1(p.price)
                p.ln.set_y2(p.price)
                p.ln.set_style(line.style_dashed)
            if not na(p.lb)
                p.lb.set_y(p.price)
                p.lb.set_text(buySide ? "EQH" : "EQL")
            merged := true
    if not merged
        line  ln = showLiq ? line.new(x, px, bar_index + 3, px, color = liqColor, style = line.style_dotted, width = lineW) : na
        label lb = showLiq ? label.new(bar_index + 3, px, buySide ? "BSL" : "SSL", style = label.style_label_left, color = NOCOLOR, textcolor = txtCol, size = lblSize) : na
        pools.unshift(Pool.new(px, x, false, ln, lb))
        while pools.size() > liqMax
            Pool old = pools.pop()
            if not na(old.ln)
                old.ln.delete()
            if not na(old.lb)
                old.lb.delete()

// Remove pools that price has run. A run that closes back inside is a sweep.
// Returns [swept, sweep wick price].
method liqUpdate(array<Pool> pools, bool buySide) =>
    bool  swept = false
    float wick  = na
    int   n     = pools.size()
    if n > 0
        for i = n - 1 to 0
            Pool p = pools.get(i)
            bool taken = buySide ? high > p.price : low < p.price
            if taken
                if buySide ? close < p.price : close > p.price
                    swept := true
                    wick  := buySide ? high : low
                if not na(p.ln)
                    p.ln.delete()
                if not na(p.lb)
                    p.lb.delete()
                pools.remove(i)
            else
                if not na(p.ln)
                    p.ln.set_x2(bar_index + 3)
                if not na(p.lb)
                    p.lb.set_x(bar_index + 3)
    [swept, wick]

// Nearest pool price at or beyond minPx (above for longs, below for shorts).
nearestPool(array<Pool> pools, float minPx, bool above) =>
    float best = na
    for p in pools
        bool ok = above ? p.price >= minPx : p.price <= minPx
        if ok and (na(best) or (above ? p.price < best : p.price > best))
            best := p.price
    best

// ─────────────────────────────────────────────────────────────────────────────
// Trade methods
// ─────────────────────────────────────────────────────────────────────────────
method extendTo(Trade t, int x) =>
    t.bxRisk.set_right(x)
    t.bxReward.set_right(x)
    t.lnEntry.set_x2(x)
    t.lnSl.set_x2(x)
    t.lnTp1.set_x2(x)
    t.lnTp2.set_x2(x)
    t.lbEntry.set_x(x)
    t.lbSl.set_x(x)
    t.lbTp1.set_x(x)
    t.lbTp2.set_x(x)

method erase(Trade t) =>
    t.bxRisk.delete()
    t.bxReward.delete()
    t.lnEntry.delete()
    t.lnSl.delete()
    t.lnTp1.delete()
    t.lnTp2.delete()
    t.lbEntry.delete()
    t.lbSl.delete()
    t.lbTp1.delete()
    t.lbTp2.delete()

method finish(Trade t, string outcome, float res, bool wasFilled) =>
    t.state   := 2
    t.outcome := outcome
    t.result  := res
    t.filled  := wasFilled
    t.extendTo(bar_index)
    t.lbSl.delete()
    t.lbTp1.delete()
    t.lbTp2.delete()
    if wasFilled
        t.bxRisk.set_bgcolor(color.new(slColor, 95))
        t.bxReward.set_bgcolor(color.new(tpColor, 95))
        color rc = res > 0 ? tpColor : res < 0 ? slColor : color.gray
        t.lbEntry.set_text(outcome + "  " + (res >= 0 ? "+" : "") + str.tostring(res, "#.##") + "R")
        t.lbEntry.set_textcolor(txtCol)
    else
        t.bxRisk.delete()
        t.bxReward.delete()
        t.lnSl.delete()
        t.lnTp1.delete()
        t.lnTp2.delete()
        t.lnEntry.set_color(color.new(color.gray, 40))
        t.lbEntry.set_text("Limit " + str.lower(outcome))
        t.lbEntry.set_textcolor(txtCol)

// Advance a live trade by one bar. Returns the event: filled, missed, expired, tp1, tp2, sl, timeout or "".
method step(Trade t) =>
    string ev    = ""
    float  risk0 = math.abs(t.entry - t.slInit)
    float  r1    = risk0 > 0 ? math.abs(t.tp1 - t.entry) / risk0 : 0.0
    float  r2    = risk0 > 0 ? math.abs(t.tp2 - t.entry) / risk0 : 0.0
    float  pct   = tp1Pct / 100.0
    if t.state == 0 and bar_index > t.startBar
        bool didFill = t.dir == 1 ? low <= t.entry : high >= t.entry
        bool ranAway = t.dir == 1 ? high >= t.tp1 : low <= t.tp1
        if didFill
            t.state   := 1
            t.fillBar := bar_index
            t.lnEntry.set_style(line.style_solid)
            ev := "filled"
        else if ranAway
            t.finish("Missed", 0.0, false)
            ev := "missed"
        else if bar_index - t.startBar >= limitExpiry
            t.finish("Expired", 0.0, false)
            ev := "expired"
    if t.state == 1 and bar_index > t.startBar and risk0 > 0
        bool hitSl = t.dir == 1 ? low <= t.sl : high >= t.sl
        bool hitT1 = t.dir == 1 ? high >= t.tp1 : low <= t.tp1
        bool hitT2 = t.dir == 1 ? high >= t.tp2 : low <= t.tp2
        if hitSl
            float slR = (t.sl - t.entry) * t.dir / risk0
            float res = t.tp1Hit ? pct * r1 + (1 - pct) * slR : -1.0
            t.finish(t.tp1Hit ? (slR == 0 ? "BE after TP1" : "SL after TP1") : "SL hit", res, true)
            ev := "sl"
        else
            if not t.tp1Hit and hitT1
                t.tp1Hit := true
                ev := "tp1"
                if pct >= 1.0
                    t.finish("TP1 hit", r1, true)
                else if beAfterTp1
                    t.sl := t.entry
                    t.lnSl.set_y1(t.entry)
                    t.lnSl.set_y2(t.entry)
                    t.lbSl.set_y(t.entry)
                    t.lbSl.set_text("SL → BE")
            if t.state == 1 and t.tp1Hit and hitT2
                t.finish("TP2 hit", pct * r1 + (1 - pct) * r2, true)
                ev := "tp2"
            if t.state == 1 and bar_index - t.startBar >= maxLife
                float openR = (close - t.entry) * t.dir / risk0
                t.finish("Timed out", t.tp1Hit ? pct * r1 + (1 - pct) * openR : openR, true)
                ev := "timeout"
    ev

newTrade(int dir, bool mkt, float entry, float sl, float tp1, float tp2) =>
    int   x2   = bar_index + 5
    float risk = math.abs(entry - sl)
    float r1   = risk > 0 ? math.abs(tp1 - entry) / risk : 0.0
    float r2   = risk > 0 ? math.abs(tp2 - entry) / risk : 0.0
    color dc   = dir == 1 ? bullColor : bearColor
    Trade t = Trade.new(dir = dir, isMarket = mkt, state = mkt ? 1 : 0, startBar = bar_index, startTime = time, fillBar = mkt ? bar_index : na, entry = entry, sl = sl, slInit = sl, tp1 = tp1, tp2 = tp2)
    t.bxRisk   := box.new(bar_index, math.max(entry, sl), x2, math.min(entry, sl), border_color = NOCOLOR, border_width = 0, bgcolor = color.new(slColor, 91))
    t.bxReward := box.new(bar_index, math.max(entry, tp1), x2, math.min(entry, tp1), border_color = NOCOLOR, border_width = 0, bgcolor = color.new(tpColor, 91))
    t.lnEntry  := line.new(bar_index, entry, x2, entry, color = dc, width = lineW, style = mkt ? line.style_solid : line.style_dashed)
    t.lnSl     := line.new(bar_index, sl, x2, sl, color = slColor, width = lineW, style = line.style_solid)
    t.lnTp1    := line.new(bar_index, tp1, x2, tp1, color = tpColor, width = lineW, style = line.style_solid)
    t.lnTp2    := line.new(bar_index, tp2, x2, tp2, color = tpColor, width = lineW, style = line.style_dotted)
    t.lbEntry  := label.new(x2, entry, (dir == 1 ? "BUY " : "SELL ") + (mkt ? "MARKET " : "LIMIT ") + str.tostring(entry, format.mintick), style = label.style_label_left, color = NOCOLOR, textcolor = txtCol, size = lblSize)
    t.lbSl     := label.new(x2, sl, "SL " + str.tostring(sl, format.mintick), style = label.style_label_left, color = NOCOLOR, textcolor = txtCol, size = lblSize)
    t.lbTp1    := label.new(x2, tp1, "TP1 " + str.tostring(tp1, format.mintick) + "  " + str.tostring(r1, "#.#") + "R", style = label.style_label_left, color = NOCOLOR, textcolor = txtCol, size = lblSize)
    t.lbTp2    := label.new(x2, tp2, "TP2 " + str.tostring(tp2, format.mintick) + "  " + str.tostring(r2, "#.#") + "R", style = label.style_label_left, color = NOCOLOR, textcolor = txtCol, size = lblSize)
    t

// ─────────────────────────────────────────────────────────────────────────────
// Helpers
// ─────────────────────────────────────────────────────────────────────────────
// Bars back (1..window) to the lowest low (findLow) or highest high, and its price.
scanExtreme(bool findLow, int window) =>
    int   idx = 1
    float ext = findLow ? low[1] : high[1]
    for i = 1 to window
        float v = findLow ? low[i] : high[i]
        if (findLow and v < ext) or (not findLow and v > ext)
            ext := v
            idx := i
    [idx, ext]

// The OB candle: the extreme candle if it is an opposite-colour candle, else the
// nearest opposite-colour candle up to 3 bars before it.
obCandle(bool bullish, int idx) =>
    int  k        = idx
    bool opposite = bullish ? close[idx] < open[idx] : close[idx] > open[idx]
    if not opposite
        for m = 1 to 3
            int j = idx + m
            if bullish ? close[j] < open[j] : close[j] > open[j]
                k := j
                break
    k

// Did the move away from bar `fromIdx` leave a fair value gap?
hasFvgSince(bool bullish, int fromIdx) =>
    bool found = false
    if fromIdx >= 2
        for j = 0 to fromIdx - 2
            if bullish ? low[j] > high[j + 2] : high[j] < low[j + 2]
                found := true
                break
    found

// Price of a Fibonacci ratio on a leg. dir = 1: 0 at the high, 1 at the low.
fibLevel(float hi, float lo, int dir, float r) =>
    dir == 1 ? hi - (hi - lo) * r : lo + (hi - lo) * r

// Structure direction on another timeframe (1 bullish, -1 bearish, 0 none yet).
htfTrendCalc(int len) =>
    float hp = ta.pivothigh(high, len, len)
    float lp = ta.pivotlow(low, len, len)
    var float h = na
    var float l = na
    var int   t = 0
    if not na(hp)
        h := hp
    if not na(lp)
        l := lp
    if not na(h) and close > h
        t := 1
        h := na
    if not na(l) and close < l
        t := -1
        l := na
    t

chk(bool c, string t) =>
    (c ? "✔ " : "✖ ") + t + "\n"

dashRow(table tb, int r, string k, string v, color vc) =>
    table.cell(tb, 0, r, k, text_color = txtCol, text_size = dashSize, text_halign = text.align_left)
    table.cell(tb, 1, r, v, text_color = txtCol, text_size = dashSize, text_halign = text.align_right)

// ─────────────────────────────────────────────────────────────────────────────
// Candle anatomy & candlestick patterns
// ─────────────────────────────────────────────────────────────────────────────
atr     = ta.atr(14)
body    = math.abs(close - open)
rng     = high - low
upW     = high - math.max(open, close)
loW     = math.min(open, close) - low
isBull  = close > open
isBear  = close < open
avgBody = ta.sma(body, 14)

bullEngulf    = isBear[1] and isBull and close >= open[1] and open <= close[1] and body > body[1]
bearEngulf    = isBull[1] and isBear and close <= open[1] and open >= close[1] and body > body[1]
hammer        = rng > 0 and loW >= rng * 0.6 and body <= rng * 0.35 and upW <= rng * 0.15
shootingStar  = rng > 0 and upW >= rng * 0.6 and body <= rng * 0.35 and loW <= rng * 0.15
doji          = rng > 0 and body <= rng * 0.1
dragonfly     = doji and loW >= upW * 2 and loW >= rng * 0.5
gravestone    = doji and upW >= loW * 2 and upW >= rng * 0.5
morningStar   = isBear[2] and body[2] > avgBody[2] and body[1] <= avgBody[1] * 0.5 and isBull and close > (open[2] + close[2]) / 2
eveningStar   = isBull[2] and body[2] > avgBody[2] and body[1] <= avgBody[1] * 0.5 and isBear and close < (open[2] + close[2]) / 2
bullHarami    = isBear[1] and isBull and body[1] > avgBody[1] and open >= close[1] and close <= open[1] and body < body[1]
bearHarami    = isBull[1] and isBear and body[1] > avgBody[1] and open <= close[1] and close >= open[1] and body < body[1]
tweezerBottom = isBear[1] and isBull and math.abs(low - low[1]) <= atr * 0.05
tweezerTop    = isBull[1] and isBear and math.abs(high - high[1]) <= atr * 0.05
threeSoldiers = isBull and isBull[1] and isBull[2] and close > close[1] and close[1] > close[2] and open > open[1] and open[1] > open[2] and body > avgBody * 0.6 and body[1] > avgBody[1] * 0.6 and body[2] > avgBody[2] * 0.6
threeCrows    = isBear and isBear[1] and isBear[2] and close < close[1] and close[1] < close[2] and open < open[1] and open[1] < open[2] and body > avgBody * 0.6 and body[1] > avgBody[1] * 0.6 and body[2] > avgBody[2] * 0.6
bullMarubozu  = isBull and rng > 0 and body >= rng * 0.9 and body > avgBody * 1.2
bearMarubozu  = isBear and rng > 0 and body >= rng * 0.9 and body > avgBody * 1.2
piercing      = isBear[1] and isBull and body[1] > avgBody[1] and open <= close[1] and close > (open[1] + close[1]) / 2 and close < open[1]
darkCloud     = isBull[1] and isBear and body[1] > avgBody[1] and open >= close[1] and close < (open[1] + close[1]) / 2 and close > open[1]

// Strongest pattern wins when several fire on the same bar.
string bullPat = useStar and morningStar ? "Morning Star" : useThree and threeSoldiers ? "3 White Soldiers" : useEngulf and bullEngulf ? "Bull Engulfing" : usePiercing and piercing ? "Piercing Line" : usePin and hammer ? "Hammer" : useTweezer and tweezerBottom ? "Tweezer Bottom" : useMarubozu and bullMarubozu ? "Bull Marubozu" : useHarami and bullHarami ? "Bull Harami" : useDoji and dragonfly ? "Dragonfly Doji" : ""
string bearPat = useStar and eveningStar ? "Evening Star" : useThree and threeCrows ? "3 Black Crows" : useEngulf and bearEngulf ? "Bear Engulfing" : usePiercing and darkCloud ? "Dark Cloud Cover" : usePin and shootingStar ? "Shooting Star" : useTweezer and tweezerTop ? "Tweezer Top" : useMarubozu and bearMarubozu ? "Bear Marubozu" : useHarami and bearHarami ? "Bear Harami" : useDoji and gravestone ? "Gravestone Doji" : ""
bool bullCandle = bullPat != ""
bool bearCandle = bearPat != ""

// ─────────────────────────────────────────────────────────────────────────────
// State
// ─────────────────────────────────────────────────────────────────────────────
ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low, swingLen, swingLen)

var float  swHigh       = na
var int    swHighBar    = na
var bool   swHighActive = false
var float  swLow        = na
var int    swLowBar     = na
var bool   swLowActive  = false
var int    trend        = 0
var string lastStruct   = "—"

// Current impulse leg (used for Fibonacci, premium / discount and targets)
var int   legDir     = 0
var float legHigh    = na
var int   legHighBar = na
var float legLow     = na
var int   legLowBar  = na

var array<Zone>  bullOBs  = array.new<Zone>()
var array<Zone>  bearOBs  = array.new<Zone>()
var array<Zone>  bullFVGs = array.new<Zone>()
var array<Zone>  bearFVGs = array.new<Zone>()
var array<Pool>  bslPools = array.new<Pool>()
var array<Pool>  sslPools = array.new<Pool>()
var array<Trade> trades   = array.new<Trade>()

// ─────────────────────────────────────────────────────────────────────────────
// Liquidity: sweeps of resting pools, then new pools from confirmed swings
// ─────────────────────────────────────────────────────────────────────────────
[bullSweepNow, bullSweepWick] = sslPools.liqUpdate(false)
[bearSweepNow, bearSweepWick] = bslPools.liqUpdate(true)

var int   lastBullSweep   = na
var float lastBullSweepPx = na
var int   lastBearSweep   = na
var float lastBearSweepPx = na
if bullSweepNow
    lastBullSweep   := bar_index
    lastBullSweepPx := bullSweepWick
    if showSweeps
        label.new(bar_index, bullSweepWick, "$", style = label.style_label_up, color = NOCOLOR, textcolor = txtCol, size = lblSize, tooltip = "Sell-side liquidity swept")
if bearSweepNow
    lastBearSweep   := bar_index
    lastBearSweepPx := bearSweepWick
    if showSweeps
        label.new(bar_index, bearSweepWick, "$", style = label.style_label_down, color = NOCOLOR, textcolor = txtCol, size = lblSize, tooltip = "Buy-side liquidity swept")
bool bullSweep = not na(lastBullSweep) and bar_index - lastBullSweep <= sweepMemory
bool bearSweep = not na(lastBearSweep) and bar_index - lastBearSweep <= sweepMemory

if not na(ph)
    bslPools.addPool(ph, bar_index - swingLen, true, atr * eqTolAtr)
if not na(pl)
    sslPools.addPool(pl, bar_index - swingLen, false, atr * eqTolAtr)

// ─────────────────────────────────────────────────────────────────────────────
// Market structure: swings, BOS / CHoCH, order blocks, current leg
// ─────────────────────────────────────────────────────────────────────────────
if not na(ph)
    float prevH = swHigh
    swHigh       := ph
    swHighBar    := bar_index - swingLen
    swHighActive := true
    if showSwings
        string t = na(prevH) ? "H" : ph > prevH ? "HH" : "LH"
        label.new(swHighBar, ph, t, style = label.style_label_down, color = NOCOLOR, textcolor = txtCol, size = lblSize)

if not na(pl)
    float prevL = swLow
    swLow       := pl
    swLowBar    := bar_index - swingLen
    swLowActive := true
    if showSwings
        string t = na(prevL) ? "L" : pl > prevL ? "HL" : "LL"
        label.new(swLowBar, pl, t, style = label.style_label_up, color = NOCOLOR, textcolor = txtCol, size = lblSize)

// Extend the running leg before checking for new breaks
if legDir == 1 and high > legHigh
    legHigh    := high
    legHighBar := bar_index
if legDir == -1 and low < legLow
    legLow    := low
    legLowBar := bar_index

bool evBullBOS   = false
bool evBullCHoCH = false
bool evBearBOS   = false
bool evBearCHoCH = false

float bullBreakPx = breakSrc == "Close" ? close : high
float bearBreakPx = breakSrc == "Close" ? close : low

if swHighActive and not na(swHigh) and bullBreakPx > swHigh
    swHighActive := false
    bool choch = trend == -1
    trend       := 1
    evBullCHoCH := choch
    evBullBOS   := not choch
    lastStruct  := choch ? "Bullish CHoCH" : "Bullish BOS"
    if showStruct
        line.new(swHighBar, swHigh, bar_index, swHigh, color = color.new(bullColor, 25), style = choch ? line.style_dashed : line.style_solid, width = lineW)
        label.new(int((swHighBar + bar_index) / 2), swHigh, choch ? "CHoCH" : "BOS", style = label.style_label_down, color = NOCOLOR, textcolor = txtCol, size = lblSize)
    // Bullish order block: last bearish candle at the pullback low before the break
    int window = math.max(1, math.min(bar_index - swHighBar, obScan))
    [idx, ext] = scanExtreme(true, window)
    int   k     = obCandle(true, idx)
    float obTop = obRangeType == "Wick" ? high[k] : math.max(open[k], close[k])
    float obBtm = obRangeType == "Wick" ? math.min(low[k], ext) : math.min(open[k], close[k])
    float cap   = obMaxAtr * atr
    if obTop - obBtm > cap and obRangeType == "Wick"
        obTop := math.max(open[k], close[k])
        obBtm := math.min(open[k], close[k])
    bool dispOK = not obNeedDisp or hasFvgSince(true, k) or body > avgBody * 1.5
    if obTop > obBtm and obTop - obBtm <= cap and dispOK and not bullOBs.overlaps(obTop, obBtm)
        box obBox = showOB ? box.new(bar_index - k, obTop, bar_index + zoneExtend, obBtm, border_color = color.new(bullColor, 55), border_width = lineW, bgcolor = obBullFill, text = "OB", text_size = lblSize, text_color = txtCol, text_halign = text.align_right) : na
        bullOBs.unshift(Zone.new(obTop, obBtm, bar_index - k, bar_index, obBox))
    // New bullish leg: from the pullback low to the breaking high
    legDir     := 1
    legLow     := ext
    legLowBar  := bar_index - idx
    legHigh    := high
    legHighBar := bar_index

if swLowActive and not na(swLow) and bearBreakPx < swLow
    swLowActive := false
    bool choch = trend == 1
    trend       := -1
    evBearCHoCH := choch
    evBearBOS   := not choch
    lastStruct  := choch ? "Bearish CHoCH" : "Bearish BOS"
    if showStruct
        line.new(swLowBar, swLow, bar_index, swLow, color = color.new(bearColor, 25), style = choch ? line.style_dashed : line.style_solid, width = lineW)
        label.new(int((swLowBar + bar_index) / 2), swLow, choch ? "CHoCH" : "BOS", style = label.style_label_up, color = NOCOLOR, textcolor = txtCol, size = lblSize)
    // Bearish order block: last bullish candle at the pullback high before the break
    int window = math.max(1, math.min(bar_index - swLowBar, obScan))
    [idx, ext] = scanExtreme(false, window)
    int   k     = obCandle(false, idx)
    float obTop = obRangeType == "Wick" ? math.max(high[k], ext) : math.max(open[k], close[k])
    float obBtm = obRangeType == "Wick" ? low[k] : math.min(open[k], close[k])
    float cap   = obMaxAtr * atr
    if obTop - obBtm > cap and obRangeType == "Wick"
        obTop := math.max(open[k], close[k])
        obBtm := math.min(open[k], close[k])
    bool dispOK = not obNeedDisp or hasFvgSince(false, k) or body > avgBody * 1.5
    if obTop > obBtm and obTop - obBtm <= cap and dispOK and not bearOBs.overlaps(obTop, obBtm)
        box obBox = showOB ? box.new(bar_index - k, obTop, bar_index + zoneExtend, obBtm, border_color = color.new(bearColor, 55), border_width = lineW, bgcolor = obBearFill, text = "OB", text_size = lblSize, text_color = txtCol, text_halign = text.align_right) : na
        bearOBs.unshift(Zone.new(obTop, obBtm, bar_index - k, bar_index, obBox))
    // New bearish leg: from the pullback high to the breaking low
    legDir     := -1
    legHigh    := ext
    legHighBar := bar_index - idx
    legLow     := low
    legLowBar  := bar_index

// ─────────────────────────────────────────────────────────────────────────────
// Fair value gaps
// ─────────────────────────────────────────────────────────────────────────────
bool bullGap = low > high[2] and (low - high[2]) >= atr * fvgMinAtr
bool bearGap = high < low[2] and (low[2] - high) >= atr * fvgMinAtr

if bullGap and not bullFVGs.overlaps(low, high[2])
    box b = showFVG ? box.new(bar_index - 2, low, bar_index + zoneExtend, high[2], border_color = color.new(#2962FF, 70), border_width = lineW, bgcolor = fvgBullFill, text = "FVG", text_size = lblSize, text_color = txtCol, text_halign = text.align_right) : na
    bullFVGs.unshift(Zone.new(low, high[2], bar_index - 2, bar_index, b))
if bearGap and not bearFVGs.overlaps(low[2], high)
    box b = showFVG ? box.new(bar_index - 2, low[2], bar_index + zoneExtend, high, border_color = color.new(#FF9800, 70), border_width = lineW, bgcolor = fvgBearFill, text = "FVG", text_size = lblSize, text_color = txtCol, text_halign = text.align_right) : na
    bearFVGs.unshift(Zone.new(low[2], high, bar_index - 2, bar_index, b))

bullOBs.trim(obMax)
bearOBs.trim(obMax)
bullFVGs.trim(fvgMax)
bearFVGs.trim(fvgMax)

// Taps and invalidation
[bullOBTap, bullOBTop, bullOBBtm]    = bullOBs.update(true, false, obKeepBroken)
[bearOBTap, bearOBTop, bearOBBtm]    = bearOBs.update(false, false, obKeepBroken)
[bullFVGTap, bullFVGTop, bullFVGBtm] = bullFVGs.update(true, true, false)
[bearFVGTap, bearFVGTop, bearFVGBtm] = bearFVGs.update(false, true, false)

// ─────────────────────────────────────────────────────────────────────────────
// Fibonacci golden zone & premium / discount on the current leg
// ─────────────────────────────────────────────────────────────────────────────
float legRange = legHigh - legLow
bool  fibValid = legDir != 0 and legRange > 0
float gzA      = fibValid ? fibLevel(legHigh, legLow, legDir, gzStart) : na
float gzB      = fibValid ? fibLevel(legHigh, legLow, legDir, gzEnd) : na
float gzTop    = math.max(gzA, gzB)
float gzBot    = math.min(gzA, gzB)
float eqLeg    = fibValid ? (legHigh + legLow) / 2 : na

bool inGZBull   = fibValid and legDir == 1 and low <= gzTop and close >= gzBot
bool inGZBear   = fibValid and legDir == -1 and high >= gzBot and close <= gzTop
bool inDiscount = fibValid and close < eqLeg
bool inPremium  = fibValid and close > eqLeg

// ─────────────────────────────────────────────────────────────────────────────
// Higher-timeframe bias (non-repainting: last closed HTF bar) & killzones
// ─────────────────────────────────────────────────────────────────────────────
int htfTrend = request.security(syminfo.tickerid, htfTf, htfTrendCalc(htfLen)[1], lookahead = barmerge.lookahead_on)

bool inKZ = not na(time(timeframe.period, kzLondon, kzTz)) or not na(time(timeframe.period, kzNY, kzTz))
bgcolor(showKZ and inKZ ? color.new(color.gray, 94) : na, title = "Killzone")

// ─────────────────────────────────────────────────────────────────────────────
// Trade management: advance every live trade by one bar
// ─────────────────────────────────────────────────────────────────────────────
var int   statTrades = 0
var int   statWins   = 0
var int   statLosses = 0
var float statNetR   = 0.0

bool evFilled = false
bool evTp1    = false
bool evTp2    = false
bool evSl     = false
bool evMissed = false
int  liveCount = 0

for t in trades
    if t.state != 2
        string ev = t.step()
        evFilled := evFilled or ev == "filled"
        evTp1    := evTp1 or ev == "tp1"
        evTp2    := evTp2 or ev == "tp2"
        evSl     := evSl or ev == "sl"
        evMissed := evMissed or ev == "missed" or ev == "expired"
    if t.state != 2
        t.extendTo(bar_index + 5)
        liveCount += 1
    if t.state == 2 and not t.counted
        t.counted := true
        if t.filled
            statTrades += 1
            statNetR   += t.result
            if t.result > 0
                statWins += 1
            else if t.result < 0
                statLosses += 1

// ─────────────────────────────────────────────────────────────────────────────
// Confluence scoring
// ─────────────────────────────────────────────────────────────────────────────
int totalF = 7 + (useHtf ? 1 : 0) + (useKZ ? 1 : 0)

bool fKZ = useKZ and inKZ

bool fTrendB  = trend == 1
bool fOBB     = bullOBTap
bool fFVGB    = bullFVGTap
bool fGZB     = inGZBull
bool fDiscB   = inDiscount
bool fCandleB = bullCandle
bool fSweepB  = bullSweep
bool fHtfB    = useHtf and htfTrend == 1

bool fTrendS  = trend == -1
bool fOBS     = bearOBTap
bool fFVGS    = bearFVGTap
bool fGZS     = inGZBear
bool fPremS   = inPremium
bool fCandleS = bearCandle
bool fSweepS  = bearSweep
bool fHtfS    = useHtf and htfTrend == -1

int scoreB = (fTrendB ? 1 : 0) + (fOBB ? 1 : 0) + (fFVGB ? 1 : 0) + (fGZB ? 1 : 0) + (fDiscB ? 1 : 0) + (fCandleB ? 1 : 0) + (fSweepB ? 1 : 0) + (fHtfB ? 1 : 0) + (fKZ ? 1 : 0)
int scoreS = (fTrendS ? 1 : 0) + (fOBS ? 1 : 0) + (fFVGS ? 1 : 0) + (fGZS ? 1 : 0) + (fPremS ? 1 : 0) + (fCandleS ? 1 : 0) + (fSweepS ? 1 : 0) + (fHtfS ? 1 : 0) + (fKZ ? 1 : 0)

bool poiB = fOBB or fFVGB or fGZB
bool poiS = fOBS or fFVGS or fGZS

// ─────────────────────────────────────────────────────────────────────────────
// Trade planning: liquidity-based targets, market vs limit execution
// ─────────────────────────────────────────────────────────────────────────────
// [risk, TP1, TP2, R:R to TP1] for an entry price and stop.
planTrade(int dir, float entry, float slPx) =>
    float risk = dir == 1 ? entry - slPx : slPx - entry
    float tp1  = na
    float tp2  = na
    if risk > 0
        float minT1 = entry + dir * risk * tp1MinR
        // TP1: nearest resting liquidity (pool or the current leg extreme) at least tp1MinR away
        float c1   = dir == 1 ? nearestPool(bslPools, minT1, true) : nearestPool(sslPools, minT1, false)
        float legT = dir == 1 ? (legDir == 1 and fibValid ? legHigh : na) : (legDir == -1 and fibValid ? legLow : na)
        if not na(legT) and dir * (legT - minT1) >= 0
            c1 := na(c1) ? legT : (dir == 1 ? math.min(c1, legT) : math.max(c1, legT))
        tp1 := na(c1) ? entry + dir * risk * 2 : c1
        // TP2: next pool beyond TP1, else the Fibonacci extension, else +1R beyond TP1
        float c2  = dir == 1 ? nearestPool(bslPools, tp1 + risk * 0.5, true) : nearestPool(sslPools, tp1 - risk * 0.5, false)
        float ext = fibValid and legDir == dir ? fibLevel(legHigh, legLow, legDir, -extLevel) : na
        tp2 := not na(c2) ? c2 : (not na(ext) and dir * (ext - tp1) > 0 ? ext : tp1 + dir * risk)
    float rr = risk > 0 ? math.abs(tp1 - entry) / risk : 0.0
    [risk, tp1, tp2, rr]

// Entry zone: the tapped OB first, then FVG, then golden zone, else the signal candle
float zTopB = fOBB ? bullOBTop : fFVGB ? bullFVGTop : fGZB ? gzTop : math.max(open, close)
float zBtmB = fOBB ? bullOBBtm : fFVGB ? bullFVGBtm : fGZB ? gzBot : low
float zTopS = fOBS ? bearOBTop : fFVGS ? bearFVGTop : fGZS ? gzTop : high
float zBtmS = fOBS ? bearOBBtm : fFVGS ? bearFVGBtm : fGZS ? gzBot : math.min(open, close)

// Optimal limit price inside the zone
float midB = (zTopB + zBtmB) / 2
float oteB = fibValid and legDir == 1 ? fibLevel(legHigh, legLow, 1, 0.705) : midB
float limB = math.max(math.min(limitAt == "Proximal edge" ? zTopB : limitAt == "50% of zone" ? midB : oteB, close), zBtmB)
float midS = (zTopS + zBtmS) / 2
float oteS = fibValid and legDir == -1 ? fibLevel(legHigh, legLow, -1, 0.705) : midS
float limS = math.min(math.max(limitAt == "Proximal edge" ? zBtmS : limitAt == "50% of zone" ? midS : oteS, close), zTopS)

// Stops sit beyond the zone, the signal candle and any swept wick (where the stop-hunt happened)
float slB = math.min(zBtmB, low, bullSweep ? lastBullSweepPx : low) - atr * slAtrBuf
float slS = math.max(zTopS, high, bearSweep ? lastBearSweepPx : high) + atr * slAtrBuf

[riskBM, tp1BM, tp2BM, rrBM] = planTrade(1, close, slB)
[riskBL, tp1BL, tp2BL, rrBL] = planTrade(1, limB, slB)
[riskSM, tp1SM, tp2SM, rrSM] = planTrade(-1, close, slS)
[riskSL, tp1SL, tp2SL, rrSL] = planTrade(-1, limS, slS)

// Market when price is still at the optimal price and R:R holds; otherwise wait with a limit
bool nearB = close - limB <= mktTolAtr * atr
bool nearS = limS - close <= mktTolAtr * atr
bool mktB  = entryMode == "Market only" or (entryMode == "Auto (market or limit)" and nearB and rrBM >= minRR)
bool mktS  = entryMode == "Market only" or (entryMode == "Auto (market or limit)" and nearS and rrSM >= minRR)

float entB  = mktB ? close : limB
float riskB = mktB ? riskBM : riskBL
float tp1B  = mktB ? tp1BM : tp1BL
float tp2B  = mktB ? tp2BM : tp2BL
float rrB   = mktB ? rrBM : rrBL
float entS  = mktS ? close : limS
float riskS = mktS ? riskSM : riskSL
float tp1S  = mktS ? tp1SM : tp1SL
float tp2S  = mktS ? tp2SM : tp2SL
float rrS   = mktS ? rrSM : rrSL

var int lastBuyBar  = na
var int lastSellBar = na

bool slotFree = not oneTrade or liveCount == 0
bool buyRaw   = barstate.isconfirmed and slotFree and (not reqTrend or fTrendB) and (not reqPOI or poiB) and (not reqCandle or fCandleB) and scoreB >= minScore and riskB > 0 and rrB >= minRR and (na(lastBuyBar) or bar_index - lastBuyBar > cooldown)
bool sellRaw  = barstate.isconfirmed and slotFree and (not reqTrend or fTrendS) and (not reqPOI or poiS) and (not reqCandle or fCandleS) and scoreS >= minScore and riskS > 0 and rrS >= minRR and (na(lastSellBar) or bar_index - lastSellBar > cooldown)
bool buySignal  = buyRaw and not sellRaw
bool sellSignal = sellRaw and not buyRaw

// ─────────────────────────────────────────────────────────────────────────────
// Signals
// ─────────────────────────────────────────────────────────────────────────────
var string lastSigText = "—"
var color  lastSigCol  = color.gray
var int    lastSigBar  = na

// Name the liquidity at a target price (EQH / BSL / EQL / SSL) or "" if none.
poolTag(array<Pool> pools, float px, bool buySide) =>
    string tag = ""
    for p in pools
        if p.price == px
            tag := p.eq ? (buySide ? "EQH" : "EQL") : (buySide ? "BSL" : "SSL")
    tag

// Plain-language reasons for the targets of a planned trade.
targetWhy(int dir, float entry, float risk, float tp1, float tp2) =>
    bool   up   = dir == 1
    string t1   = poolTag(up ? bslPools : sslPools, tp1, up)
    string t2   = poolTag(up ? bslPools : sslPools, tp2, up)
    float  legX = up ? legHigh : legLow
    float  ext  = fibValid and legDir == dir ? fibLevel(legHigh, legLow, legDir, -extLevel) : na
    string r1   = t1 != "" ? "nearest " + t1 + " liquidity" : tp1 == legX ? "leg " + (up ? "high" : "low") + " (resting stops)" : "2R (no liquidity in range)"
    string r2   = t2 != "" ? "next " + t2 + " liquidity" : (not na(ext) and tp2 == ext) ? "fib -" + str.tostring(extLevel) + " extension" : "+1R beyond TP1"
    string mg   = tp1Pct >= 100 ? "close 100% at TP1" : "close " + str.tostring(tp1Pct) + "% at TP1" + (beAfterTp1 ? ", SL to entry" : "")
    "TP1: " + r1 + "\nTP2: " + r2 + "\n" + mg

lvlName(bool isBuy) =>
    limitAt == "Proximal edge" ? (isBuy ? "top of" : "bottom of") : limitAt == "50% of zone" ? "50% of" : "OTE 0.705 in"

if buySignal
    lastBuyBar := bar_index
    string otype = mktB ? "MARKET" : "LIMIT"
    string why = ""
    why += chk(fTrendB, "Bullish market structure")
    why += chk(fOBB, "Bullish order block tapped")
    why += chk(fFVGB, "Bullish FVG tapped")
    why += chk(fGZB, "OTE zone (" + str.tostring(gzStart) + "–" + str.tostring(gzEnd) + ")")
    why += chk(fDiscB, "Price in discount")
    why += chk(fCandleB, "Candle: " + (fCandleB ? bullPat : "none"))
    why += chk(fSweepB, "Sell-side liquidity swept")
    if useHtf
        why += chk(fHtfB, "HTF structure bullish (" + htfTf + ")")
    if useKZ
        why += chk(fKZ, "Inside a killzone")
    string zoneB = fOBB ? "bullish OB" : fFVGB ? "bullish FVG" : fGZB ? "OTE zone" : "signal candle"
    string optB  = lvlName(true) + " " + zoneB
    string ordB  = entryMode == "Market only" ? "Market only (settings)" : entryMode == "Limit only" ? "Limit only (settings)\nwaits at " + optB : mktB ? "Close is " + fmtPips(close - limB) + " from the\noptimal price (" + optB + ")\nso enter now at market" : (nearB ? "Market R:R " + str.tostring(rrBM, "#.#") + " is below " + str.tostring(minRR) : "Price is " + fmtPips(close - limB) + " past the optimal price") + "\nlimit at " + optB + "\nexpires in " + str.tostring(limitExpiry) + " bars"
    string slWB  = "Below the " + zoneB + (bullSweep ? " and the\nSSL sweep wick" : "") + "\n+ " + str.tostring(slAtrBuf) + " × ATR buffer (" + fmtPips(atr * slAtrBuf) + ")"
    string tpWB  = targetWhy(1, entB, riskB, tp1B, tp2B)
    string tip = "BUY " + otype + "  ·  confluence " + str.tostring(scoreB) + "/" + str.tostring(totalF) + "\n" + why
    tip += "\n" + otype + " entry " + str.tostring(entB, format.mintick) + (mktB ? "" : "  (expires in " + str.tostring(limitExpiry) + " bars)")
    tip += "\nSL " + str.tostring(slB, format.mintick) + " (" + fmtPips(entB - slB) + ")  |  TP1 " + str.tostring(tp1B, format.mintick) + " (" + fmtPips(tp1B - entB) + ", " + str.tostring(rrB, "#.#") + "R)  |  TP2 " + str.tostring(tp2B, format.mintick) + " (" + fmtPips(tp2B - entB) + ")"
    label.new(bar_index, low, "BUY " + (mktB ? "MKT" : "LMT") + " " + str.tostring(scoreB) + "/" + str.tostring(totalF), yloc = yloc.belowbar, style = label.style_label_up, color = bullColor, textcolor = txtCol, size = lblSize, tooltip = tip)
    Trade nt = newTrade(1, mktB, entB, slB, tp1B, tp2B)
    nt.score    := scoreB
    nt.total    := totalF
    nt.why      := why
    nt.orderWhy := ordB
    nt.slWhy    := slWB
    nt.tpWhy    := tpWB
    trades.unshift(nt)
    lastSigText := "BUY " + otype + " @ " + str.tostring(entB, format.mintick)
    lastSigCol  := bullColor
    lastSigBar  := bar_index

if sellSignal
    lastSellBar := bar_index
    string otype = mktS ? "MARKET" : "LIMIT"
    string why = ""
    why += chk(fTrendS, "Bearish market structure")
    why += chk(fOBS, "Bearish order block tapped")
    why += chk(fFVGS, "Bearish FVG tapped")
    why += chk(fGZS, "OTE zone (" + str.tostring(gzStart) + "–" + str.tostring(gzEnd) + ")")
    why += chk(fPremS, "Price in premium")
    why += chk(fCandleS, "Candle: " + (fCandleS ? bearPat : "none"))
    why += chk(fSweepS, "Buy-side liquidity swept")
    if useHtf
        why += chk(fHtfS, "HTF structure bearish (" + htfTf + ")")
    if useKZ
        why += chk(fKZ, "Inside a killzone")
    string zoneS = fOBS ? "bearish OB" : fFVGS ? "bearish FVG" : fGZS ? "OTE zone" : "signal candle"
    string optS  = lvlName(false) + " " + zoneS
    string ordS  = entryMode == "Market only" ? "Market only (settings)" : entryMode == "Limit only" ? "Limit only (settings)\nwaits at " + optS : mktS ? "Close is " + fmtPips(limS - close) + " from the\noptimal price (" + optS + ")\nso enter now at market" : (nearS ? "Market R:R " + str.tostring(rrSM, "#.#") + " is below " + str.tostring(minRR) : "Price is " + fmtPips(limS - close) + " past the optimal price") + "\nlimit at " + optS + "\nexpires in " + str.tostring(limitExpiry) + " bars"
    string slWS  = "Above the " + zoneS + (bearSweep ? " and the\nBSL sweep wick" : "") + "\n+ " + str.tostring(slAtrBuf) + " × ATR buffer (" + fmtPips(atr * slAtrBuf) + ")"
    string tpWS  = targetWhy(-1, entS, riskS, tp1S, tp2S)
    string tip = "SELL " + otype + "  ·  confluence " + str.tostring(scoreS) + "/" + str.tostring(totalF) + "\n" + why
    tip += "\n" + otype + " entry " + str.tostring(entS, format.mintick) + (mktS ? "" : "  (expires in " + str.tostring(limitExpiry) + " bars)")
    tip += "\nSL " + str.tostring(slS, format.mintick) + " (" + fmtPips(slS - entS) + ")  |  TP1 " + str.tostring(tp1S, format.mintick) + " (" + fmtPips(entS - tp1S) + ", " + str.tostring(rrS, "#.#") + "R)  |  TP2 " + str.tostring(tp2S, format.mintick) + " (" + fmtPips(entS - tp2S) + ")"
    label.new(bar_index, high, "SELL " + (mktS ? "MKT" : "LMT") + " " + str.tostring(scoreS) + "/" + str.tostring(totalF), yloc = yloc.abovebar, style = label.style_label_down, color = bearColor, textcolor = txtCol, size = lblSize, tooltip = tip)
    Trade nt = newTrade(-1, mktS, entS, slS, tp1S, tp2S)
    nt.score    := scoreS
    nt.total    := totalF
    nt.why      := why
    nt.orderWhy := ordS
    nt.slWhy    := slWS
    nt.tpWhy    := tpWS
    trades.unshift(nt)
    lastSigText := "SELL " + otype + " @ " + str.tostring(entS, format.mintick)
    lastSigCol  := bearColor
    lastSigBar  := bar_index

// Keep only the newest finished trades on the chart (live trades are never removed)
int closedN = 0
for t in trades
    if t.state == 2
        closedN += 1
int excess = closedN - keepSetups
if excess > 0 and trades.size() > 0
    for i = trades.size() - 1 to 0
        if excess > 0
            Trade t = trades.get(i)
            if t.state == 2
                t.erase()
                trades.remove(i)
                excess -= 1

// Candlestick pattern labels: text only, skipped on signal bars (the signal tooltip names the pattern)
bool showBullPat = candleMode != "Off" and bullCandle and not buySignal and (not cdlTrendOnly or trend == 1) and (candleMode == "All" or poiB or bullSweep)
bool showBearPat = candleMode != "Off" and bearCandle and not sellSignal and (not cdlTrendOnly or trend == -1) and (candleMode == "All" or poiS or bearSweep)
if showBullPat
    label.new(bar_index, low, bullPat, yloc = yloc.belowbar, style = label.style_none, textcolor = txtCol, size = lblSize)
if showBearPat
    label.new(bar_index, high, bearPat, yloc = yloc.abovebar, style = label.style_none, textcolor = txtCol, size = lblSize)

// ─────────────────────────────────────────────────────────────────────────────
// Last-bar drawings: Fibonacci, golden zone, premium / discount, dashboard
// ─────────────────────────────────────────────────────────────────────────────
var array<float> FIB_LEVELS = array.from(0.0, 0.382, 0.5, 0.618, 0.705, 0.786, 1.0)
var array<line>  fibLines   = array.new<line>()
var array<label> fibLabels  = array.new<label>()
var box gzBox   = na
var box premBox = na
var box discBox = na

if barstate.islast
    for l in fibLines
        l.delete()
    fibLines.clear()
    for lb in fibLabels
        lb.delete()
    fibLabels.clear()
    gzBox.delete()
    premBox.delete()
    discBox.delete()

    if fibValid
        int x1 = math.min(legLowBar, legHighBar)
        int xe = bar_index + 15
        if showFib
            for r in FIB_LEVELS
                float p = fibLevel(legHigh, legLow, legDir, r)
                fibLines.push(line.new(x1, p, xe, p, color = color.new(fibColor, r == 0.5 ? 30 : 60), style = r == 0.0 or r == 1.0 ? line.style_solid : line.style_dotted, width = lineW))
                string nm = r == 0.5 ? "0.5 EQ" : str.tostring(r)
                fibLabels.push(label.new(xe, p, nm + "  " + str.tostring(p, format.mintick), style = label.style_label_left, color = NOCOLOR, textcolor = txtCol, size = lblSize))
            float pe = fibLevel(legHigh, legLow, legDir, -extLevel)
            fibLines.push(line.new(x1, pe, xe, pe, color = color.new(tpColor, 50), style = line.style_dotted, width = lineW))
            fibLabels.push(label.new(xe, pe, "-" + str.tostring(extLevel) + "  " + str.tostring(pe, format.mintick), style = label.style_label_left, color = NOCOLOR, textcolor = txtCol, size = lblSize))
            gzBox := box.new(x1, gzTop, xe, gzBot, border_color = color.new(#FFD600, 75), border_width = lineW, bgcolor = gzFill, text = "OTE", text_size = lblSize, text_color = txtCol, text_halign = text.align_left)
        if showPD
            premBox := box.new(x1, legHigh, xe, eqLeg, border_color = NOCOLOR, bgcolor = color.new(bearColor, 95), text = "Premium", text_size = lblSize, text_color = txtCol, text_halign = text.align_right, text_valign = text.align_top)
            discBox := box.new(x1, eqLeg, xe, legLow, border_color = NOCOLOR, bgcolor = color.new(bullColor, 95), text = "Discount", text_size = lblSize, text_color = txtCol, text_halign = text.align_right, text_valign = text.align_bottom)

dashPos = switch dashPosIn
    "Top left"     => position.top_left
    "Bottom right" => position.bottom_right
    "Bottom left"  => position.bottom_left
    => position.top_right

var table dash = table.new(dashPos, 2, 15, bgcolor = color.new(#131722, 8), border_color = color.new(color.gray, 80), border_width = 1, frame_color = color.new(color.gray, 70), frame_width = 1)

if barstate.islast and showDash
    color neutral = color.new(color.white, 30)
    string biasTxt = trend == 1 ? "Bullish" : trend == -1 ? "Bearish" : "Undefined"
    color  biasCol = trend == 1 ? bullColor : trend == -1 ? bearColor : neutral
    string htfTxt  = not useHtf ? "Off" : htfTrend == 1 ? "Bullish" : htfTrend == -1 ? "Bearish" : "Undefined"
    color  htfCol  = not useHtf ? neutral : htfTrend == 1 ? bullColor : htfTrend == -1 ? bearColor : neutral
    string fibTxt  = not fibValid ? "No leg yet" : (inGZBull or inGZBear) ? "In OTE zone" : legDir == 1 ? "Bull leg" : "Bear leg"
    string pdTxt   = inDiscount ? "Discount" : inPremium ? "Premium" : "—"
    color  pdCol   = inDiscount ? bullColor : inPremium ? bearColor : neutral
    float  nBsl    = nearestPool(bslPools, close, true)
    float  nSsl    = nearestPool(sslPools, close, false)
    string liqTxt  = bullSweep ? "SSL just swept" : bearSweep ? "BSL just swept" : "BSL " + (na(nBsl) ? "—" : str.tostring(nBsl, format.mintick)) + " / SSL " + (na(nSsl) ? "—" : str.tostring(nSsl, format.mintick))
    color  liqCol  = bullSweep ? bullColor : bearSweep ? bearColor : neutral
    string kzTxt   = inKZ ? "Active" : "Closed"
    // Live trade status
    string setupTxt = "No open setup"
    color  setupCol = neutral
    for t in trades
        if t.state != 2
            string side = t.dir == 1 ? "BUY" : "SELL"
            setupTxt := t.state == 0 ? side + " LIMIT pending @ " + str.tostring(t.entry, format.mintick) : side + (t.isMarket ? " MKT" : " LMT") + " open" + (t.tp1Hit ? " · TP1 ✔" : "")
            setupCol := t.dir == 1 ? bullColor : bearColor
            break
    float  winRate  = statTrades > 0 ? statWins * 100.0 / statTrades : 0.0
    string statTxt  = str.tostring(statTrades) + " trades · " + str.tostring(winRate, "#") + "% · " + (statNetR >= 0 ? "+" : "") + str.tostring(statNetR, "#.#") + "R"
    string sigAge   = na(lastSigBar) ? "" : "  (" + str.tostring(bar_index - lastSigBar) + " bars ago)"

    table.cell(dash, 0, 0, "SMC Confluence Mapper", text_color = txtCol, text_size = dashSize, text_halign = text.align_left)
    table.cell(dash, 1, 0, syminfo.ticker + " · " + timeframe.period, text_color = txtCol, text_size = dashSize, text_halign = text.align_right)
    dashRow(dash, 1, "Bias", biasTxt, biasCol)
    dashRow(dash, 2, "Last structure", lastStruct, str.contains(lastStruct, "Bull") ? bullColor : str.contains(lastStruct, "Bear") ? bearColor : neutral)
    dashRow(dash, 3, "HTF bias (" + htfTf + ")", htfTxt, htfCol)
    dashRow(dash, 4, "Fibonacci", fibTxt, (inGZBull or inGZBear) ? #FFD600 : neutral)
    dashRow(dash, 5, "Premium / Discount", pdTxt, pdCol)
    dashRow(dash, 6, "Liquidity", liqTxt, liqCol)
    dashRow(dash, 7, "Killzone", useKZ or showKZ ? kzTxt : "Off", inKZ and (useKZ or showKZ) ? #FFD600 : neutral)
    dashRow(dash, 8, "Active OBs / FVGs", str.tostring(bullOBs.size()) + "▲ " + str.tostring(bearOBs.size()) + "▼  /  " + str.tostring(bullFVGs.size()) + "▲ " + str.tostring(bearFVGs.size()) + "▼", neutral)
    dashRow(dash, 9, "Candle pattern", bullCandle ? bullPat : bearCandle ? bearPat : "—", bullCandle ? bullColor : bearCandle ? bearColor : neutral)
    dashRow(dash, 10, "Buy confluence", str.tostring(scoreB) + " / " + str.tostring(totalF), scoreB >= minScore ? bullColor : neutral)
    dashRow(dash, 11, "Sell confluence", str.tostring(scoreS) + " / " + str.tostring(totalF), scoreS >= minScore ? bearColor : neutral)
    dashRow(dash, 12, "Setup", setupTxt, setupCol)
    dashRow(dash, 13, "Last signal", lastSigText + sigAge, lastSigCol)
    dashRow(dash, 14, "Results (this chart)", statTxt, statNetR > 0 ? bullColor : statNetR < 0 ? bearColor : neutral)

// ─────────────────────────────────────────────────────────────────────────────
// Trade card: the latest setup in full — levels, pips, R and the reasons
// ─────────────────────────────────────────────────────────────────────────────
cardPos = switch cardPosIn
    "Top right"    => position.top_right
    "Top left"     => position.top_left
    "Bottom left"  => position.bottom_left
    "Middle right" => position.middle_right
    => position.bottom_right

var table card = table.new(cardPos, 3, 12, bgcolor = color.new(#131722, 5), border_color = color.new(color.gray, 80), border_width = 1, frame_color = color.new(color.gray, 60), frame_width = 1)

cardRow(int r, string k, string v1, string v2) =>
    table.cell(card, 0, r, k, text_color = txtCol, text_size = dashSize, text_halign = text.align_left, text_valign = text.align_top)
    table.cell(card, 1, r, v1, text_color = txtCol, text_size = dashSize, text_halign = text.align_left, text_valign = text.align_top)
    table.cell(card, 2, r, v2, text_color = txtCol, text_size = dashSize, text_halign = text.align_left, text_valign = text.align_top)

if barstate.islast and showCard
    table.clear(card, 0, 0, 2, 11)
    if trades.size() == 0
        cardRow(0, "Trade card", "No setup yet", "")
    else
        Trade t     = trades.get(0)
        bool  up    = t.dir == 1
        color dc    = up ? bullColor : bearColor
        float risk  = math.abs(t.entry - t.slInit)
        float r1    = risk > 0 ? math.abs(t.tp1 - t.entry) / risk : 0.0
        float r2    = risk > 0 ? math.abs(t.tp2 - t.entry) / risk : 0.0
        string side = (up ? "BUY " : "SELL ") + (t.isMarket ? "MARKET" : "LIMIT")
        string status = t.state == 0 ? "Pending" : t.state == 1 ? (t.tp1Hit ? "Open · TP1 hit" : "Open") : t.filled ? t.outcome + "  " + (t.result >= 0 ? "+" : "") + str.tostring(t.result, "#.##") + "R" : "Limit " + str.lower(t.outcome)
        color stCol = t.state == 2 and t.filled ? (t.result > 0 ? tpColor : t.result < 0 ? slColor : color.gray) : t.state == 0 ? color.new(#FFD600, 40) : dc
        cardRow(0, side, syminfo.ticker + " · " + timeframe.period, status)
        table.cell_set_bgcolor(card, 0, 0, dc)
        table.cell_set_bgcolor(card, 2, 0, color.new(stCol, 40))
        cardRow(1, "Entry", str.tostring(t.entry, format.mintick), t.isMarket ? "market" : "limit")
        cardRow(2, "Stop loss", str.tostring(t.slInit, format.mintick), "-" + fmtPips(risk) + "  ·  -1R")
        cardRow(3, "Take profit 1", str.tostring(t.tp1, format.mintick), "+" + fmtPips(t.tp1 - t.entry) + "  ·  " + str.tostring(r1, "#.#") + "R")
        cardRow(4, "Take profit 2", str.tostring(t.tp2, format.mintick), "+" + fmtPips(t.tp2 - t.entry) + "  ·  " + str.tostring(r2, "#.#") + "R")
        cardRow(5, "Risk : Reward", "1 : " + str.tostring(r1, "#.#") + " (TP1)", "1 : " + str.tostring(r2, "#.#") + " (TP2)")
        cardRow(6, "Confluence", str.tostring(t.score) + " / " + str.tostring(t.total), "min " + str.tostring(minScore))
        cardRow(7, "Why this trade", t.why, "")
        cardRow(8, "Why " + (t.isMarket ? "market" : "limit"), t.orderWhy, "")
        cardRow(9, "Why this stop", t.slWhy, "")
        cardRow(10, "Why these targets", t.tpWhy, "")
        cardRow(11, "Signal", str.tostring(bar_index - t.startBar) + " bars ago", str.format_time(t.startTime, "dd MMM HH:mm", syminfo.timezone))
        table.cell_set_bgcolor(card, 2, 2, color.new(slColor, 80))
        table.cell_set_bgcolor(card, 2, 3, color.new(tpColor, 80))
        table.cell_set_bgcolor(card, 2, 4, color.new(tpColor, 80))

// ─────────────────────────────────────────────────────────────────────────────
// Data window & alerts
// ─────────────────────────────────────────────────────────────────────────────
plot(scoreB, "Buy confluence score", color = bullColor, display = display.data_window)
plot(scoreS, "Sell confluence score", color = bearColor, display = display.data_window)
plot(fibValid ? gzTop : na, "OTE zone top", color = fibColor, display = display.data_window)
plot(fibValid ? gzBot : na, "OTE zone bottom", color = fibColor, display = display.data_window)

alertcondition(buySignal, "SMC-CM: Buy setup", "SMC-CM BUY setup on {{ticker}} ({{interval}}) at {{close}}")
alertcondition(sellSignal, "SMC-CM: Sell setup", "SMC-CM SELL setup on {{ticker}} ({{interval}}) at {{close}}")
alertcondition(evFilled, "SMC-CM: Limit filled", "SMC-CM limit order filled on {{ticker}} ({{interval}})")
alertcondition(evTp1 or evTp2, "SMC-CM: Take profit hit", "SMC-CM take profit hit on {{ticker}} ({{interval}})")
alertcondition(evSl, "SMC-CM: Stop loss hit", "SMC-CM stop loss hit on {{ticker}} ({{interval}})")
alertcondition(evBullBOS or evBearBOS, "SMC-CM: BOS", "SMC-CM break of structure on {{ticker}} ({{interval}})")
alertcondition(evBullCHoCH or evBearCHoCH, "SMC-CM: CHoCH", "SMC-CM change of character on {{ticker}} ({{interval}})")
alertcondition(bullSweepNow or bearSweepNow, "SMC-CM: Liquidity sweep", "SMC-CM liquidity sweep on {{ticker}} ({{interval}})")

if buySignal
    alert("SMC-CM BUY " + (mktB ? "MARKET" : "LIMIT") + " " + syminfo.ticker + " " + timeframe.period + " | score " + str.tostring(scoreB) + "/" + str.tostring(totalF) + " | entry " + str.tostring(entB, format.mintick) + " | SL " + str.tostring(slB, format.mintick) + " | TP1 " + str.tostring(tp1B, format.mintick) + " | TP2 " + str.tostring(tp2B, format.mintick), alert.freq_once_per_bar_close)
if sellSignal
    alert("SMC-CM SELL " + (mktS ? "MARKET" : "LIMIT") + " " + syminfo.ticker + " " + timeframe.period + " | score " + str.tostring(scoreS) + "/" + str.tostring(totalF) + " | entry " + str.tostring(entS, format.mintick) + " | SL " + str.tostring(slS, format.mintick) + " | TP1 " + str.tostring(tp1S, format.mintick) + " | TP2 " + str.tostring(tp2S, format.mintick), alert.freq_once_per_bar_close)
if evFilled
    alert("SMC-CM limit order filled on " + syminfo.ticker + " " + timeframe.period, alert.freq_once_per_bar_close)
if evTp1
    alert("SMC-CM TP1 hit on " + syminfo.ticker + " " + timeframe.period + (beAfterTp1 ? " — SL moved to entry" : ""), alert.freq_once_per_bar_close)
if evTp2
    alert("SMC-CM TP2 hit on " + syminfo.ticker + " " + timeframe.period, alert.freq_once_per_bar_close)
if evSl
    alert("SMC-CM stop loss hit on " + syminfo.ticker + " " + timeframe.period, alert.freq_once_per_bar_close)
if evMissed
    alert("SMC-CM limit order cancelled (missed / expired) on " + syminfo.ticker + " " + timeframe.period, alert.freq_once_per_bar_close)
