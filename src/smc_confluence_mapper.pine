//@version=6
// ════════════════════════════════════════════════════════════════════════════
//  SMC Confluence Mapper  v3.2
//  Smart Money Concepts trade planner: liquidity sweep → structure shift →
//  retrace into an order block / FVG / OTE, confirmed by textbook candlestick
//  patterns. Every setup is planned as MARKET or LIMIT, explained in plain
//  language, drawn with its expected path, and tracked to its outcome.
//  © Wisdom — All rights reserved. See LICENSE.
// ════════════════════════════════════════════════════════════════════════════
indicator("SMC Confluence Mapper", shorttitle = "SMC-CM", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500, max_bars_back = 1000)

// ─────────────────────────────────────────────────────────────────────────────
// Inputs
// ─────────────────────────────────────────────────────────────────────────────
G_MS  = "Market Structure"
G_OB  = "Order Blocks"
G_FVG = "Fair Value Gaps"
G_LIQ = "Liquidity (BSL / SSL)"
G_MOD = "Entry Model"
G_KZ  = "Killzones"
G_CDL = "Candlestick Patterns"
G_FIB = "Fibonacci & Premium / Discount"
G_ORD = "Order Execution & Trade Management"
G_HTF = "Higher-Timeframe Bias"
G_STY = "Style"
G_CRD = "Trade Card & Alerts"

swingLen     = input.int(5, "Swing length", minval = 2, maxval = 50, group = G_MS, tooltip = "Bars on each side needed to confirm a swing high / low. Higher values give fewer, more significant swings.")
breakSrc     = input.string("Close", "Break confirmation", options = ["Close", "Wick"], group = G_MS, tooltip = "Close: a candle must CLOSE beyond the swing to count as a break. Wick: any trade beyond the swing counts.")
showSwings   = input.bool(true, "Label swings (HH / HL / LH / LL)", group = G_MS)
showStruct   = input.bool(true, "Show BOS / CHoCH", group = G_MS)

showOB       = input.bool(true, "Show order blocks", group = G_OB)
obRangeType  = input.string("Wick", "Order block range", options = ["Wick", "Body"], group = G_OB, tooltip = "Wick: the OB candle's full high-to-low range. Body: open-to-close only.")
obMaxAtr     = input.float(1.5, "Max OB height (× ATR)", minval = 0.2, maxval = 10.0, step = 0.1, group = G_OB, tooltip = "Taller wick OBs are refined to the candle body. If the body is still taller, the OB is skipped as low quality.")
obNeedDisp   = input.bool(true, "Require displacement after the OB", group = G_OB, tooltip = "The move away from the OB must leave a fair value gap or a strong candle (body > 1.5 × average).")
obMax        = input.int(2, "Max active OBs per side", minval = 1, maxval = 20, group = G_OB)
obScan       = input.int(150, "Max bars scanned for the OB candle", minval = 10, maxval = 500, group = G_OB)
obKeepBroken = input.bool(false, "Keep invalidated OBs (greyed out)", group = G_OB)
showMid      = input.bool(true, "Show 50% line in OBs and FVGs", group = G_OB, tooltip = "Mean threshold of an order block / consequent encroachment of a fair value gap.")

showFVG      = input.bool(true, "Show fair value gaps", group = G_FVG)
fvgMinAtr    = input.float(0.3, "Minimum gap size (× ATR)", minval = 0.0, maxval = 5.0, step = 0.05, group = G_FVG)
fvgMitigation = input.string("50% (CE)", "Remove FVG when", options = ["50% (CE)", "Full fill"], group = G_FVG)
fvgMax       = input.int(2, "Max active FVGs per side", minval = 1, maxval = 30, group = G_FVG)

showLiq      = input.bool(true, "Show liquidity pools (BSL / SSL)", group = G_LIQ, tooltip = "Buy-side liquidity rests above swing highs, sell-side below swing lows. Equal highs / lows (EQH / EQL) are the strongest pools.")
liqMax       = input.int(3, "Pools tracked per side", minval = 1, maxval = 15, group = G_LIQ)
eqTolAtr     = input.float(0.1, "Equal highs / lows tolerance (× ATR)", minval = 0.0, maxval = 1.0, step = 0.01, group = G_LIQ)
showSweeps   = input.bool(true, "Mark liquidity sweeps", group = G_LIQ)

entryModel   = input.string("Sweep → Shift → Retrace", "Entry model", options = ["Sweep → Shift → Retrace", "Confluence score only"], group = G_MOD, tooltip = "Sweep → Shift → Retrace (the core SMC model): price first takes liquidity on one side, then breaks structure the other way, then you enter on the pullback into a zone. Confluence score only: any bar that reaches the minimum score.")
modelWindow  = input.int(30, "Setup window (bars)", minval = 3, maxval = 300, group = G_MOD, tooltip = "The sweep, the structure shift and the entry must all happen within this many bars.")
minScore     = input.int(4, "Minimum confluence score", minval = 1, maxval = 9, group = G_MOD)
reqTrend     = input.bool(true, "Require structure in the trade direction", group = G_MOD)
reqPOI       = input.bool(true, "Require a zone (OB / FVG / OTE)", group = G_MOD)
reqCandle    = input.bool(true, "Require a confirmation candlestick pattern", group = G_MOD)
minRR        = input.float(2.0, "Minimum R:R to TP1", minval = 0.0, maxval = 20.0, step = 0.1, group = G_MOD)
slAtrBuf     = input.float(0.25, "Stop-loss buffer (× ATR)", minval = 0.0, maxval = 5.0, step = 0.05, group = G_MOD)
cooldown     = input.int(5, "Bars between signals (same side)", minval = 0, maxval = 200, group = G_MOD)
oneTrade     = input.bool(true, "One trade at a time", group = G_MOD)

useKZ        = input.bool(false, "Count killzone timing as a factor", group = G_KZ)
showKZ       = input.bool(false, "Shade killzones", group = G_KZ)
kzTz         = input.string("America/New_York", "Killzone timezone", group = G_KZ)
kzLondon     = input.session("0200-0500", "London killzone", group = G_KZ)
kzNY         = input.session("0700-1000", "New York killzone", group = G_KZ)

candleMode   = input.string("At zones only", "Label candlestick patterns", options = ["All", "At zones only", "Off"], group = G_CDL, tooltip = "At zones only: label a pattern only when it forms at an order block, FVG, OTE zone or right after a liquidity sweep.")
useEngulf    = input.bool(true, "Engulfing", group = G_CDL, inline = "c1")
usePin       = input.bool(true, "Hammer / Shooting star / Hanging man / Inverted hammer", group = G_CDL, inline = "c1")
useStar      = input.bool(true, "Morning / Evening star", group = G_CDL, inline = "c2")
useHarami    = input.bool(true, "Harami", group = G_CDL, inline = "c2")
useTweezer   = input.bool(true, "Tweezer top / bottom", group = G_CDL, inline = "c3")
useThree     = input.bool(true, "3 Soldiers / 3 Crows", group = G_CDL, inline = "c3")
useMarubozu  = input.bool(true, "Marubozu", group = G_CDL, inline = "c4")
usePiercing  = input.bool(true, "Piercing / Dark cloud", group = G_CDL, inline = "c4")
useDoji      = input.bool(true, "Dragonfly / Gravestone doji", group = G_CDL, inline = "c5")
showPatBox   = input.bool(true, "Box the candles that form the pattern", group = G_CDL, tooltip = "Draws a dotted box around exactly the 1, 2 or 3 candles that make up the pattern, so anyone can see which candles it refers to.")

showFib      = input.bool(true, "Draw Fibonacci on the current leg", group = G_FIB)
gzStart      = input.float(0.618, "OTE zone start", minval = 0.0, maxval = 1.0, step = 0.001, group = G_FIB)
gzEnd        = input.float(0.786, "OTE zone end", minval = 0.0, maxval = 1.0, step = 0.001, group = G_FIB)
extLevel     = input.float(0.272, "Extension beyond the leg", minval = 0.0, maxval = 3.0, step = 0.001, group = G_FIB, tooltip = "Used as TP2 when no liquidity pool lies beyond TP1.")
showPD       = input.bool(false, "Show premium / discount zones", group = G_FIB)

entryMode    = input.string("Auto (market or limit)", "Order type", options = ["Auto (market or limit)", "Market only", "Limit only"], group = G_ORD, tooltip = "Auto: MARKET when the signal candle closes near the optimal price and the R:R holds; otherwise a LIMIT order waits back inside the zone.")
limitAt      = input.string("50% of zone", "Limit price inside zone", options = ["Proximal edge", "50% of zone", "OTE 0.705"], group = G_ORD)
mktTolAtr    = input.float(0.3, "Market entry if close is within (× ATR) of limit", minval = 0.0, maxval = 5.0, step = 0.05, group = G_ORD)
limitExpiry  = input.int(10, "Limit order expires after (bars)", minval = 1, maxval = 200, group = G_ORD)
tp1MinR      = input.float(1.0, "TP1 must be at least (R) away", minval = 0.1, maxval = 10.0, step = 0.1, group = G_ORD)
minSlPips    = input.float(30.0, "Minimum stop loss (pips)", minval = 0.0, maxval = 1000.0, step = 1.0, group = G_ORD, tooltip = "If the structural stop is closer than this, it is moved out to this distance so normal noise does not stop the trade out.")
maxTp1R      = input.float(3.0, "Cap TP1 at (R)", minval = 0.5, maxval = 20.0, step = 0.1, group = G_ORD, tooltip = "Keeps the first target realistic: a liquidity target further than this is brought in to this many R.")
maxTp2R      = input.float(5.0, "Cap TP2 at (R)", minval = 0.5, maxval = 30.0, step = 0.1, group = G_ORD)
tp1Pct       = input.int(50, "Close % at TP1", minval = 0, maxval = 100, group = G_ORD)
beAfterTp1   = input.bool(true, "Move SL to entry after TP1", group = G_ORD)
maxLife      = input.int(100, "Close trade after (bars)", minval = 5, maxval = 1000, group = G_ORD)
keepSetups   = input.int(2, "Finished trades kept on chart", minval = 0, maxval = 20, group = G_ORD)
showPath     = input.bool(true, "Draw the expected path", group = G_ORD)
showZoneBox  = input.bool(true, "Highlight the entry zone", group = G_ORD)

useHtf       = input.bool(false, "Count higher-timeframe structure as a factor", group = G_HTF)
htfTf        = input.timeframe("240", "HTF timeframe", group = G_HTF)
htfLen       = input.int(5, "HTF swing length", minval = 2, maxval = 50, group = G_HTF)

lineW        = input.int(1, "Line width", minval = 1, maxval = 4, group = G_STY)
mapSizeIn    = input.string("Tiny", "Chart annotation size", options = ["Tiny", "Small", "Normal"], group = G_STY, tooltip = "Swings, BOS / CHoCH, zones, patterns, liquidity.")
tradeSizeIn  = input.string("Small", "Trade label size", options = ["Tiny", "Small", "Normal"], group = G_STY, tooltip = "Signal, entry, stop loss and targets.")
zoneExtend   = input.int(10, "Extend zones right (bars)", minval = 0, maxval = 100, group = G_STY)
bullColor    = input.color(#00C853, "Buy", group = G_STY, inline = "s1")
bearColor    = input.color(#FF1744, "Sell", group = G_STY, inline = "s1")
entryColor   = input.color(#FFD600, "Entry", group = G_STY, inline = "s1")
slColor      = input.color(#FF1744, "Stop loss", group = G_STY, inline = "s2")
tpColor      = input.color(#00E676, "Take profit", group = G_STY, inline = "s2")
pathColor    = input.color(#29B6F6, "Expected path", group = G_STY, inline = "s2")
obBullFill   = input.color(color.new(#00C853, 88), "Bull OB", group = G_STY, inline = "s3")
obBearFill   = input.color(color.new(#FF1744, 88), "Bear OB", group = G_STY, inline = "s3")
fvgBullFill  = input.color(color.new(#2962FF, 90), "Bull FVG", group = G_STY, inline = "s4")
fvgBearFill  = input.color(color.new(#FF9800, 90), "Bear FVG", group = G_STY, inline = "s4")
fibColor     = input.color(#9598A1, "Fib levels", group = G_STY, inline = "s5")
gzFill       = input.color(color.new(#FFD600, 92), "OTE zone", group = G_STY, inline = "s5")
liqColor     = input.color(color.new(#B2B5BE, 25), "Liquidity", group = G_STY, inline = "s6")
txtCol       = input.color(color.white, "Text", group = G_STY, inline = "s6")

showCard     = input.bool(true, "Show trade card", group = G_CRD)
cardPosIn    = input.string("Bottom right", "Trade card position", options = ["Top right", "Top left", "Bottom right", "Bottom left", "Middle right"], group = G_CRD)
cardSizeIn   = input.string("Small", "Trade card text size", options = ["Tiny", "Small", "Normal"], group = G_CRD)
pipSizeIn    = input.float(0.0, "Pip size (0 = auto)", minval = 0.0, step = 0.00001, group = G_CRD, tooltip = "Auto: forex 0.0001 (0.01 for JPY pairs), gold 0.1, everything else 1 tick.")
alertFormat  = input.string("Plain text", "Alert message format", options = ["Plain text", "JSON (webhook)"], group = G_CRD, tooltip = "Plain text: the full trade plan and reasons, ready to copy and share. JSON: machine-readable order for a webhook bridge that places trades.")

sizeOf(string s) =>
    s == "Tiny" ? size.tiny : s == "Small" ? size.small : size.normal
mapSize   = sizeOf(mapSizeIn)
tradeSize = sizeOf(tradeSizeIn)
cardSize  = sizeOf(cardSizeIn)
fvgCE     = fvgMitigation == "50% (CE)"
modelOn   = entryModel == "Sweep → Shift → Retrace"
NOCOLOR   = color.new(color.black, 100)

// Pip size: forex 5/3-decimal quotes use 10 ticks per pip, gold 0.1, others 1 tick
pipSize() =>
    float mt = syminfo.mintick
    float p  = mt
    if pipSizeIn > 0
        p := pipSizeIn
    else if syminfo.type == "forex"
        int dec = int(math.round(math.log10(1 / mt)))
        p := dec == 3 or dec == 5 ? mt * 10 : mt
    else if str.contains(syminfo.ticker, "XAU")
        p := 0.1
    p
PIP = pipSize()

fmtPips(float d) =>
    str.tostring(math.abs(d) / PIP, "#.#") + " pips"

px(float p) =>
    str.tostring(p, format.mintick)

tfName() =>
    timeframe.isminutes ? (timeframe.multiplier % 60 == 0 ? str.tostring(timeframe.multiplier / 60) + "H" : str.tostring(timeframe.multiplier) + "m") : timeframe.period

// ─────────────────────────────────────────────────────────────────────────────
// Types
// ─────────────────────────────────────────────────────────────────────────────
type Zone
    float top
    float btm
    int   left
    int   created
    box   bx  = na
    line  mid = na

type Pool
    float price
    int   left
    bool  eq = false
    line  ln = na
    label lb = na

type Trade
    int    dir
    bool   isMarket
    int    state
    int    startBar
    int    startTime
    int    expiryTime
    int    fillBar
    int    fillTime
    float  entry
    float  sl
    float  slInit
    float  tp1
    float  tp2
    bool   tp1Hit  = false
    bool   filled  = false
    bool   counted = false
    float  result  = 0.0
    string outcome = ""
    int    score   = 0
    int    total   = 0
    string why     = ""
    string plan    = ""
    box    bxRisk   = na
    box    bxReward = na
    line   lnEntry  = na
    line   lnSl     = na
    line   lnTp1    = na
    line   lnTp2    = na
    label  lbEntry  = na
    label  lbSl     = na
    label  lbTp1    = na
    label  lbTp2    = na
    box    bxZone   = na
    label  lbMark   = na
    label  lbFill   = na

// ─────────────────────────────────────────────────────────────────────────────
// Zone methods (order blocks & FVGs)
// ─────────────────────────────────────────────────────────────────────────────
method kill(Zone z) =>
    if not na(z.bx)
        z.bx.delete()
    if not na(z.mid)
        z.mid.delete()

// Keep at most maxN zones (newest are at index 0).
method trim(array<Zone> zones, int maxN) =>
    while zones.size() > maxN
        Zone z = zones.pop()
        z.kill()

method overlaps(array<Zone> zones, float top, float btm) =>
    bool hit = false
    for z in zones
        if top >= z.btm and btm <= z.top
            hit := true
    hit

// Extend live zones, detect taps on this bar, remove invalidated zones.
// Returns [tapped, top of tapped zone, bottom of tapped zone].
method update(array<Zone> zones, bool bullish, bool isFvg, bool keepBroken) =>
    bool  tapped = false
    float tTop   = na
    float tBtm   = na
    int   n      = zones.size()
    if n > 0
        for i = n - 1 to 0
            Zone  z      = zones.get(i)
            float fvgLvl = fvgCE ? (z.top + z.btm) / 2 : (bullish ? z.btm : z.top)
            bool invalid = isFvg ? (bullish ? low <= fvgLvl : high >= fvgLvl) : (bullish ? close < z.btm : close > z.top)
            bool touch   = bar_index > z.created and (bullish ? (low <= z.top and close >= z.btm) : (high >= z.btm and close <= z.top))
            if touch
                tapped := true
                tTop   := z.top
                tBtm   := z.btm
            if invalid
                if keepBroken and not isFvg and not na(z.bx)
                    z.bx.set_right(bar_index)
                    z.bx.set_bgcolor(color.new(color.gray, 92))
                    z.bx.set_border_color(color.new(color.gray, 80))
                    if not na(z.mid)
                        z.mid.delete()
                else
                    z.kill()
                zones.remove(i)
            else
                if not na(z.bx)
                    z.bx.set_right(bar_index + zoneExtend)
                if not na(z.mid)
                    z.mid.set_x2(bar_index + zoneExtend)
    [tapped, tTop, tBtm]

newZone(int left, float top, float btm, color fill, color border, string txt) =>
    box  b = box.new(left, top, bar_index + zoneExtend, btm, border_color = border, border_width = lineW, bgcolor = fill, text = txt, text_size = mapSize, text_color = txtCol, text_halign = text.align_right)
    line m = showMid ? line.new(left, (top + btm) / 2, bar_index + zoneExtend, (top + btm) / 2, color = border, style = line.style_dotted, width = 1) : na
    Zone.new(top, btm, left, bar_index, b, m)

// ─────────────────────────────────────────────────────────────────────────────
// Liquidity pool methods
// ─────────────────────────────────────────────────────────────────────────────
// Add a pool at a confirmed swing, or merge it into an existing one as EQH / EQL.
method addPool(array<Pool> pools, float price, int x, bool buySide, float tol) =>
    bool merged = false
    for p in pools
        if not merged and math.abs(p.price - price) <= tol
            p.eq    := true
            p.price := buySide ? math.max(p.price, price) : math.min(p.price, price)
            if not na(p.ln)
                p.ln.set_y1(p.price)
                p.ln.set_y2(p.price)
                p.ln.set_style(line.style_dashed)
            if not na(p.lb)
                p.lb.set_y(p.price)
                p.lb.set_text(buySide ? "EQH" : "EQL")
            merged := true
    if not merged
        line  ln = showLiq ? line.new(x, price, bar_index + 3, price, color = liqColor, style = line.style_dotted, width = lineW) : na
        label lb = showLiq ? label.new(bar_index + 3, price, buySide ? "BSL" : "SSL", style = label.style_label_left, color = NOCOLOR, textcolor = txtCol, size = mapSize) : na
        pools.unshift(Pool.new(price, x, false, ln, lb))
        while pools.size() > liqMax
            Pool old = pools.pop()
            if not na(old.ln)
                old.ln.delete()
            if not na(old.lb)
                old.lb.delete()

// Remove pools that price has run. A run that closes back inside is a sweep.
// Returns [swept, sweep wick price].
method liqUpdate(array<Pool> pools, bool buySide) =>
    bool  swept = false
    float wick  = na
    int   n     = pools.size()
    if n > 0
        for i = n - 1 to 0
            Pool p = pools.get(i)
            bool taken = buySide ? high > p.price : low < p.price
            if taken
                if buySide ? close < p.price : close > p.price
                    swept := true
                    wick  := buySide ? high : low
                if not na(p.ln)
                    p.ln.delete()
                if not na(p.lb)
                    p.lb.delete()
                pools.remove(i)
            else
                if not na(p.ln)
                    p.ln.set_x2(bar_index + 3)
                if not na(p.lb)
                    p.lb.set_x(bar_index + 3)
    [swept, wick]

// Nearest pool price at or beyond minPx (above for longs, below for shorts).
nearestPool(array<Pool> pools, float minPx, bool above) =>
    float best = na
    for p in pools
        bool ok = above ? p.price >= minPx : p.price <= minPx
        if ok and (na(best) or (above ? p.price < best : p.price > best))
            best := p.price
    best

// ─────────────────────────────────────────────────────────────────────────────
// Trade methods
// ─────────────────────────────────────────────────────────────────────────────
method extendTo(Trade t, int x) =>
    t.bxRisk.set_right(x)
    t.bxReward.set_right(x)
    t.lnEntry.set_x2(x)
    t.lnSl.set_x2(x)
    t.lnTp1.set_x2(x)
    t.lnTp2.set_x2(x)
    t.lbEntry.set_x(x)
    t.lbSl.set_x(x)
    t.lbTp1.set_x(x)
    t.lbTp2.set_x(x)
    if not na(t.bxZone)
        t.bxZone.set_right(x)

method erase(Trade t) =>
    t.bxRisk.delete()
    t.bxReward.delete()
    t.lnEntry.delete()
    t.lnSl.delete()
    t.lnTp1.delete()
    t.lnTp2.delete()
    t.lbEntry.delete()
    t.lbSl.delete()
    t.lbTp1.delete()
    t.lbTp2.delete()
    t.bxZone.delete()
    t.lbMark.delete()
    t.lbFill.delete()

method finish(Trade t, string outcome, float res, bool wasFilled) =>
    t.state   := 2
    t.outcome := outcome
    t.result  := res
    t.filled  := wasFilled
    t.extendTo(bar_index)
    t.lbSl.delete()
    t.lbTp1.delete()
    t.lbTp2.delete()
    if wasFilled
        if not na(t.bxZone)
            t.bxZone.set_bgcolor(color.new(entryColor, 95))
            t.bxZone.set_text("")
        t.bxRisk.set_bgcolor(color.new(slColor, 95))
        t.bxReward.set_bgcolor(color.new(tpColor, 95))
        color rc = res > 0 ? tpColor : res < 0 ? slColor : color.gray
        t.lbEntry.set_text(outcome + "  " + (res >= 0 ? "+" : "") + str.tostring(res, "#.##") + "R")
        t.lbEntry.set_color(color.new(rc, 15))
    else
        t.bxRisk.delete()
        t.bxReward.delete()
        t.lnSl.delete()
        t.lnTp1.delete()
        t.lnTp2.delete()
        t.bxZone.delete()
        t.lbMark.delete()
        t.lnEntry.set_color(color.new(color.gray, 40))
        t.lbEntry.set_text("Limit " + str.lower(outcome))
        t.lbEntry.set_color(color.new(color.gray, 30))

// Advance a live trade by one bar. Returns the event: filled, missed, expired, tp1, tp2, sl, timeout or "".
method step(Trade t) =>
    string ev    = ""
    float  risk0 = math.abs(t.entry - t.slInit)
    float  r1    = risk0 > 0 ? math.abs(t.tp1 - t.entry) / risk0 : 0.0
    float  r2    = risk0 > 0 ? math.abs(t.tp2 - t.entry) / risk0 : 0.0
    float  pct   = tp1Pct / 100.0
    if t.state == 0 and bar_index > t.startBar
        bool didFill = t.dir == 1 ? low <= t.entry : high >= t.entry
        bool ranAway = t.dir == 1 ? high >= t.tp1 : low <= t.tp1
        if didFill
            t.state    := 1
            t.fillBar  := bar_index
            t.fillTime := time
            t.lnEntry.set_style(line.style_solid)
            t.lbEntry.set_text((t.dir == 1 ? "▶ BUY LIMIT  " : "▶ SELL LIMIT  ") + px(t.entry) + "\nfilled " + str.format_time(time, "dd MMM HH:mm", syminfo.timezone))
            t.lbFill := label.new(bar_index, t.entry, "✔ FILLED  " + px(t.entry), style = t.dir == 1 ? label.style_label_up : label.style_label_down, color = color.new(entryColor, 10), textcolor = color.black, size = mapSize, tooltip = "Limit order filled at " + px(t.entry) + " on " + str.format_time(time, "dd MMM yyyy HH:mm", syminfo.timezone))
            ev := "filled"
        else if ranAway
            t.finish("Missed", 0.0, false)
            ev := "missed"
        else if bar_index - t.startBar >= limitExpiry
            t.finish("Expired", 0.0, false)
            ev := "expired"
    if t.state == 1 and bar_index > t.startBar and risk0 > 0
        bool hitSl = t.dir == 1 ? low <= t.sl : high >= t.sl
        bool hitT1 = t.dir == 1 ? high >= t.tp1 : low <= t.tp1
        bool hitT2 = t.dir == 1 ? high >= t.tp2 : low <= t.tp2
        if hitSl
            float slR = (t.sl - t.entry) * t.dir / risk0
            float res = t.tp1Hit ? pct * r1 + (1 - pct) * slR : -1.0
            t.finish(t.tp1Hit ? (slR == 0 ? "BE after TP1" : "SL after TP1") : "SL hit", res, true)
            ev := "sl"
        else
            if not t.tp1Hit and hitT1
                t.tp1Hit := true
                ev := "tp1"
                if pct >= 1.0
                    t.finish("TP1 hit", r1, true)
                else if beAfterTp1
                    t.sl := t.entry
                    t.lnSl.set_y1(t.entry)
                    t.lnSl.set_y2(t.entry)
                    t.lbSl.set_y(t.entry)
                    t.lbSl.set_text("SL moved to entry (BE)")
            if t.state == 1 and t.tp1Hit and hitT2
                t.finish("TP2 hit", pct * r1 + (1 - pct) * r2, true)
                ev := "tp2"
            if t.state == 1 and bar_index - t.startBar >= maxLife
                float openR = (close - t.entry) * t.dir / risk0
                t.finish("Timed out", t.tp1Hit ? pct * r1 + (1 - pct) * openR : openR, true)
                ev := "timeout"
    ev

newTrade(int dir, bool mkt, float entry, float sl, float tp1, float tp2, float zTop, float zBtm, int expiry) =>
    int    x2   = bar_index + 8
    float  risk = math.abs(entry - sl)
    float  r1   = risk > 0 ? math.abs(tp1 - entry) / risk : 0.0
    float  r2   = risk > 0 ? math.abs(tp2 - entry) / risk : 0.0
    string when = str.format_time(time, "dd MMM HH:mm", syminfo.timezone)
    string side = (dir == 1 ? "BUY " : "SELL ") + (mkt ? "MARKET" : "LIMIT")
    Trade t = Trade.new(dir = dir, isMarket = mkt, state = mkt ? 1 : 0, startBar = bar_index, startTime = time, expiryTime = expiry, fillBar = mkt ? bar_index : na, fillTime = mkt ? time : na, entry = entry, sl = sl, slInit = sl, tp1 = tp1, tp2 = tp2)
    if showZoneBox and zTop > zBtm
        t.bxZone := box.new(bar_index, zTop, x2, zBtm, border_color = color.new(entryColor, 30), border_width = 1, border_style = line.style_dashed, bgcolor = color.new(entryColor, 85), text = "ENTRY ZONE", text_size = mapSize, text_color = txtCol, text_halign = text.align_left, text_valign = text.align_top)
    t.bxRisk   := box.new(bar_index, math.max(entry, sl), x2, math.min(entry, sl), border_color = NOCOLOR, border_width = 0, bgcolor = color.new(slColor, 90))
    t.bxReward := box.new(bar_index, math.max(entry, tp1), x2, math.min(entry, tp1), border_color = NOCOLOR, border_width = 0, bgcolor = color.new(tpColor, 90))
    t.lnEntry  := line.new(bar_index, entry, x2, entry, color = entryColor, width = lineW + 2, style = mkt ? line.style_solid : line.style_dashed)
    t.lnSl     := line.new(bar_index, sl, x2, sl, color = slColor, width = lineW + 1, style = line.style_solid)
    t.lnTp1    := line.new(bar_index, tp1, x2, tp1, color = tpColor, width = lineW + 1, style = line.style_solid)
    t.lnTp2    := line.new(bar_index, tp2, x2, tp2, color = tpColor, width = lineW, style = line.style_dashed)
    string eTxt = mkt ? "▶ " + side + "  " + px(entry) + "\nfilled " + when : "▶ " + side + "  " + px(entry) + "\nplaced " + when + "  ·  valid to " + str.format_time(expiry, "dd MMM HH:mm", syminfo.timezone)
    t.lbEntry  := label.new(x2, entry, eTxt, style = label.style_label_left, color = entryColor, textcolor = color.black, size = tradeSize)
    t.lbMark   := label.new(bar_index, entry, "", style = label.style_diamond, color = entryColor, size = size.small, tooltip = "Entry coordinate: " + px(entry) + " at " + str.format_time(time, "dd MMM yyyy HH:mm", syminfo.timezone))
    t.lbSl     := label.new(x2, sl, "SL  " + px(sl) + "  ·  -" + fmtPips(risk) + "  ·  -1R", style = label.style_label_left, color = color.new(slColor, 10), textcolor = txtCol, size = tradeSize)
    t.lbTp1    := label.new(x2, tp1, "TP1  " + px(tp1) + "  ·  +" + fmtPips(tp1 - entry) + "  ·  " + str.tostring(r1, "#.#") + "R", style = label.style_label_left, color = color.new(tpColor, 10), textcolor = color.black, size = tradeSize)
    t.lbTp2    := label.new(x2, tp2, "TP2  " + px(tp2) + "  ·  +" + fmtPips(tp2 - entry) + "  ·  " + str.tostring(r2, "#.#") + "R", style = label.style_label_left, color = color.new(tpColor, 35), textcolor = color.black, size = tradeSize)
    t

// ─────────────────────────────────────────────────────────────────────────────
// Helpers
// ─────────────────────────────────────────────────────────────────────────────
// Bars back (1..window) to the lowest low (findLow) or highest high, and its price.
scanExtreme(bool findLow, int window) =>
    int   idx = 1
    float ext = findLow ? low[1] : high[1]
    for i = 1 to window
        float v = findLow ? low[i] : high[i]
        if (findLow and v < ext) or (not findLow and v > ext)
            ext := v
            idx := i
    [idx, ext]

// The OB candle: the last opposite-colour candle at or just before the extreme.
obCandle(bool bullish, int idx) =>
    int  k        = idx
    bool opposite = bullish ? close[idx] < open[idx] : close[idx] > open[idx]
    if not opposite
        for m = 1 to 3
            int j = idx + m
            if bullish ? close[j] < open[j] : close[j] > open[j]
                k := j
                break
    k

// Did the move away from bar `fromIdx` leave a fair value gap?
hasFvgSince(bool bullish, int fromIdx) =>
    bool found = false
    if fromIdx >= 2
        for j = 0 to fromIdx - 2
            if bullish ? low[j] > high[j + 2] : high[j] < low[j + 2]
                found := true
                break
    found

// Price of a Fibonacci ratio on a leg. dir = 1: 0 at the high, 1 at the low.
fibLevel(float hi, float lo, int dir, float r) =>
    dir == 1 ? hi - (hi - lo) * r : lo + (hi - lo) * r

// Structure direction on another timeframe (1 bullish, -1 bearish, 0 none yet).
htfTrendCalc(int len) =>
    float hp = ta.pivothigh(high, len, len)
    float lp = ta.pivotlow(low, len, len)
    var float h = na
    var float l = na
    var int   t = 0
    if not na(hp)
        h := hp
    if not na(lp)
        l := lp
    if not na(h) and close > h
        t := 1
        h := na
    if not na(l) and close < l
        t := -1
        l := na
    t

// ─────────────────────────────────────────────────────────────────────────────
// Candle anatomy & candlestick patterns (textbook definitions, Nison / Bulkowski)
// Every reversal pattern needs the prior trend it reverses, and single-candle
// patterns must be a meaningful size (range ≥ 0.5 × ATR).
// ─────────────────────────────────────────────────────────────────────────────
atr     = ta.atr(14)
body    = math.abs(close - open)
rng     = high - low
upW     = high - math.max(open, close)
loW     = math.min(open, close) - low
bodyTop = math.max(open, close)
bodyBot = math.min(open, close)
isBull  = close > open
isBear  = close < open
avgBody = ta.sma(body, 14)
sma10   = ta.sma(close, 10)
low5    = ta.lowest(low, 5)
high5   = ta.highest(high, 5)
okSize  = rng >= atr * 0.5

// Prior trend at bar offset o: below / above its 10-bar average and lower / higher than 5 bars earlier
downAt(int o) =>
    close[o] < sma10[o] and close[o] < close[o + 5]
upAt(int o) =>
    close[o] > sma10[o] and close[o] > close[o + 5]

// Evaluated once per bar so every pattern sees a consistent value
dn1 = downAt(1)
dn2 = downAt(2)
dn3 = downAt(3)
up1 = upAt(1)
up2 = upAt(2)
up3 = upAt(3)

// Hammer family: lower shadow ≥ 2× body, little or no upper shadow (≤ 10% of range)
hammerShape   = okSize and body >= rng * 0.05 and loW >= body * 2 and upW <= rng * 0.1
// Shooting-star family: upper shadow ≥ 2× body, little or no lower shadow
starShape     = okSize and body >= rng * 0.05 and upW >= body * 2 and loW <= rng * 0.1
hammer        = hammerShape and dn1
hangingMan    = hammerShape and up1
shootingStar  = starShape and up1
invHammer     = starShape and dn1
// Engulfing: second real body completely covers the first real body, opposite colour
bullEngulf    = dn1 and isBear[1] and isBull and body[1] >= avgBody[1] * 0.3 and open <= close[1] and close >= open[1] and body > body[1]
bearEngulf    = up1 and isBull[1] and isBear and body[1] >= avgBody[1] * 0.3 and open >= close[1] and close <= open[1] and body > body[1]
// Harami: long first candle, small second real body inside the first real body
bullHarami    = dn1 and isBear[1] and body[1] >= avgBody[1] and isBull and bodyTop <= open[1] and bodyBot >= close[1] and body <= body[1] * 0.5
bearHarami    = up1 and isBull[1] and body[1] >= avgBody[1] and isBear and bodyTop <= close[1] and bodyBot >= open[1] and body <= body[1] * 0.5
// Piercing / dark cloud: long first candle, second closes past the midpoint of the first body
piercing      = dn1 and isBear[1] and body[1] >= avgBody[1] and isBull and open <= close[1] and close > (open[1] + close[1]) / 2 and close < open[1]
darkCloud     = up1 and isBull[1] and body[1] >= avgBody[1] and isBear and open >= close[1] and close < (open[1] + close[1]) / 2 and close > open[1]
// Stars: long candle, small-bodied star beyond its body, strong candle closing past the first body's midpoint
morningStar   = dn2 and isBear[2] and body[2] >= avgBody[2] and body[1] <= body[2] * 0.3 and bodyTop[1] <= close[2] + body[2] * 0.25 and isBull and body >= avgBody * 0.6 and close > (open[2] + close[2]) / 2
eveningStar   = up2 and isBull[2] and body[2] >= avgBody[2] and body[1] <= body[2] * 0.3 and bodyBot[1] >= close[2] - body[2] * 0.25 and isBear and body >= avgBody * 0.6 and close < (open[2] + close[2]) / 2
// Three soldiers / crows: three long candles, each opening inside the prior body and closing near its extreme
threeSoldiers = dn3 and isBull and isBull[1] and isBull[2] and close > close[1] and close[1] > close[2] and open >= open[1] and open <= close[1] and open[1] >= open[2] and open[1] <= close[2] and body >= avgBody * 0.8 and body[1] >= avgBody[1] * 0.8 and body[2] >= avgBody[2] * 0.8 and upW <= rng * 0.25 and upW[1] <= rng[1] * 0.25 and upW[2] <= rng[2] * 0.25
threeCrows    = up3 and isBear and isBear[1] and isBear[2] and close < close[1] and close[1] < close[2] and open <= open[1] and open >= close[1] and open[1] <= open[2] and open[1] >= close[2] and body >= avgBody * 0.8 and body[1] >= avgBody[1] * 0.8 and body[2] >= avgBody[2] * 0.8 and loW <= rng * 0.25 and loW[1] <= rng[1] * 0.25 and loW[2] <= rng[2] * 0.25
// Marubozu: all body, almost no shadows, clearly larger than average
bullMarubozu  = isBull and okSize and body >= rng * 0.9 and body >= avgBody * 1.3
bearMarubozu  = isBear and okSize and body >= rng * 0.9 and body >= avgBody * 1.3
// Tweezers: two candles of opposite colour sharing the same low / high, which is the 5-bar extreme
tweezerBottom = dn1 and isBear[1] and isBull and math.abs(low - low[1]) <= rng * 0.05 and math.min(low, low[1]) <= low5
tweezerTop    = up1 and isBull[1] and isBear and math.abs(high - high[1]) <= rng * 0.05 and math.max(high, high[1]) >= high5
// Dragonfly / gravestone doji: almost no body, one long shadow, no opposite shadow
dragonfly     = okSize and body <= rng * 0.05 and upW <= rng * 0.1 and dn1
gravestone    = okSize and body <= rng * 0.05 and loW <= rng * 0.1 and up1

// Strongest pattern wins when several fire on the same bar.
string bullPat = useStar and morningStar ? "Morning Star" : useThree and threeSoldiers ? "3 White Soldiers" : useEngulf and bullEngulf ? "Bullish Engulfing" : usePiercing and piercing ? "Piercing Line" : usePin and hammer ? "Hammer" : usePin and invHammer ? "Inverted Hammer" : useTweezer and tweezerBottom ? "Tweezer Bottom" : useMarubozu and bullMarubozu ? "Bullish Marubozu" : useHarami and bullHarami ? "Bullish Harami" : useDoji and dragonfly ? "Dragonfly Doji" : ""
string bearPat = useStar and eveningStar ? "Evening Star" : useThree and threeCrows ? "3 Black Crows" : useEngulf and bearEngulf ? "Bearish Engulfing" : usePiercing and darkCloud ? "Dark Cloud Cover" : usePin and shootingStar ? "Shooting Star" : usePin and hangingMan ? "Hanging Man" : useTweezer and tweezerTop ? "Tweezer Top" : useMarubozu and bearMarubozu ? "Bearish Marubozu" : useHarami and bearHarami ? "Bearish Harami" : useDoji and gravestone ? "Gravestone Doji" : ""
bool bullCandle = bullPat != ""
bool bearCandle = bearPat != ""

// What each pattern means, in plain words
patMeaning(string p) =>
    switch p
        "Morning Star"      => "sellers lost steam and buyers took over"
        "3 White Soldiers"  => "three strong up candles in a row"
        "Bullish Engulfing" => "one up candle swallowed the last down candle"
        "Piercing Line"     => "buyers pushed back past half of the last drop"
        "Hammer"            => "sellers pushed down but buyers closed it near the top"
        "Inverted Hammer"   => "buyers tested higher after a fall"
        "Tweezer Bottom"    => "price hit the same low twice and held"
        "Bullish Marubozu"  => "a full-body up candle with no hesitation"
        "Bullish Harami"    => "selling stalled inside the last big down candle"
        "Dragonfly Doji"    => "sellers were rejected all the way back up"
        "Evening Star"      => "buyers lost steam and sellers took over"
        "3 Black Crows"     => "three strong down candles in a row"
        "Bearish Engulfing" => "one down candle swallowed the last up candle"
        "Dark Cloud Cover"  => "sellers pushed back past half of the last rise"
        "Shooting Star"     => "buyers pushed up but sellers closed it near the bottom"
        "Hanging Man"       => "sellers showed up after a rise"
        "Tweezer Top"       => "price hit the same high twice and failed"
        "Bearish Marubozu"  => "a full-body down candle with no hesitation"
        "Bearish Harami"    => "buying stalled inside the last big up candle"
        "Gravestone Doji"   => "buyers were rejected all the way back down"
        => ""

// How many candles each pattern is made of
patLen(string p) =>
    switch p
        "Morning Star"      => 3
        "Evening Star"      => 3
        "3 White Soldiers"  => 3
        "3 Black Crows"     => 3
        "Bullish Engulfing" => 2
        "Bearish Engulfing" => 2
        "Piercing Line"     => 2
        "Dark Cloud Cover"  => 2
        "Tweezer Bottom"    => 2
        "Tweezer Top"       => 2
        "Bullish Harami"    => 2
        "Bearish Harami"    => 2
        => 1

hi2 = ta.highest(high, 2)
hi3 = ta.highest(high, 3)
lo2 = ta.lowest(low, 2)
lo3 = ta.lowest(low, 3)
TFMS = timeframe.in_seconds() * 1000

// Dotted box around exactly the candles that form the pattern, with its name
markPattern(string p, bool bull, bool withName) =>
    int   n   = patLen(p)
    float top = n == 3 ? hi3 : n == 2 ? hi2 : high
    float bot = n == 3 ? lo3 : n == 2 ? lo2 : low
    color c   = bull ? bullColor : bearColor
    if showPatBox
        box.new(time[n - 1] - TFMS / 2, top, time + TFMS / 2, bot, xloc = xloc.bar_time, border_color = color.new(c, 10), border_width = 1, border_style = line.style_dotted, bgcolor = color.new(c, 92))
    if withName
        label.new(bar_index, bull ? bot : top, p, style = bull ? label.style_label_up : label.style_label_down, color = NOCOLOR, textcolor = txtCol, size = mapSize, tooltip = p + " (" + str.tostring(n) + (n == 1 ? " candle" : " candles") + "): " + patMeaning(p))

// ─────────────────────────────────────────────────────────────────────────────
// State
// ─────────────────────────────────────────────────────────────────────────────
ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low, swingLen, swingLen)

var float  swHigh       = na
var int    swHighBar    = na
var bool   swHighActive = false
var float  swLow        = na
var int    swLowBar     = na
var bool   swLowActive  = false
var int    trend        = 0
var int    lastBullBreakBar = na
var int    lastBearBreakBar = na

// Current impulse leg (used for Fibonacci, premium / discount and targets)
var int   legDir     = 0
var float legHigh    = na
var int   legHighBar = na
var float legLow     = na
var int   legLowBar  = na

var array<Zone>  bullOBs  = array.new<Zone>()
var array<Zone>  bearOBs  = array.new<Zone>()
var array<Zone>  bullFVGs = array.new<Zone>()
var array<Zone>  bearFVGs = array.new<Zone>()
var array<Pool>  bslPools = array.new<Pool>()
var array<Pool>  sslPools = array.new<Pool>()
var array<Trade> trades   = array.new<Trade>()

// ─────────────────────────────────────────────────────────────────────────────
// Liquidity: sweeps of resting pools, then new pools from confirmed swings
// ─────────────────────────────────────────────────────────────────────────────
[bullSweepNow, bullSweepWick] = sslPools.liqUpdate(false)
[bearSweepNow, bearSweepWick] = bslPools.liqUpdate(true)

var int   lastBullSweep   = na
var float lastBullSweepPx = na
var int   lastBearSweep   = na
var float lastBearSweepPx = na
if bullSweepNow
    lastBullSweep   := bar_index
    lastBullSweepPx := bullSweepWick
    if showSweeps
        label.new(bar_index, bullSweepWick, "$", style = label.style_label_up, color = NOCOLOR, textcolor = txtCol, size = mapSize, tooltip = "Sell-side liquidity swept: price dipped under an old low to take stop losses, then closed back above it")
if bearSweepNow
    lastBearSweep   := bar_index
    lastBearSweepPx := bearSweepWick
    if showSweeps
        label.new(bar_index, bearSweepWick, "$", style = label.style_label_down, color = NOCOLOR, textcolor = txtCol, size = mapSize, tooltip = "Buy-side liquidity swept: price spiked above an old high to take stop losses, then closed back below it")
bool bullSweep = not na(lastBullSweep) and bar_index - lastBullSweep <= modelWindow
bool bearSweep = not na(lastBearSweep) and bar_index - lastBearSweep <= modelWindow

if not na(ph)
    bslPools.addPool(ph, bar_index - swingLen, true, atr * eqTolAtr)
if not na(pl)
    sslPools.addPool(pl, bar_index - swingLen, false, atr * eqTolAtr)

// ─────────────────────────────────────────────────────────────────────────────
// Market structure: swings, BOS / CHoCH, order blocks, current leg
// ─────────────────────────────────────────────────────────────────────────────
if not na(ph)
    float prevH = swHigh
    swHigh       := ph
    swHighBar    := bar_index - swingLen
    swHighActive := true
    if showSwings
        string t = na(prevH) ? "H" : ph > prevH ? "HH" : "LH"
        label.new(swHighBar, ph, t, style = label.style_label_down, color = NOCOLOR, textcolor = txtCol, size = mapSize)

if not na(pl)
    float prevL = swLow
    swLow       := pl
    swLowBar    := bar_index - swingLen
    swLowActive := true
    if showSwings
        string t = na(prevL) ? "L" : pl > prevL ? "HL" : "LL"
        label.new(swLowBar, pl, t, style = label.style_label_up, color = NOCOLOR, textcolor = txtCol, size = mapSize)

// Extend the running leg before checking for new breaks
if legDir == 1 and high > legHigh
    legHigh    := high
    legHighBar := bar_index
if legDir == -1 and low < legLow
    legLow    := low
    legLowBar := bar_index

bool evBullBOS   = false
bool evBullCHoCH = false
bool evBearBOS   = false
bool evBearCHoCH = false

float bullBreakPx = breakSrc == "Close" ? close : high
float bearBreakPx = breakSrc == "Close" ? close : low

if swHighActive and not na(swHigh) and bullBreakPx > swHigh
    swHighActive := false
    bool choch = trend == -1
    trend            := 1
    lastBullBreakBar := bar_index
    evBullCHoCH      := choch
    evBullBOS        := not choch
    if showStruct
        line.new(swHighBar, swHigh, bar_index, swHigh, color = color.new(bullColor, 25), style = choch ? line.style_dashed : line.style_solid, width = lineW)
        label.new(int((swHighBar + bar_index) / 2), swHigh, choch ? "CHoCH" : "BOS", style = label.style_label_down, color = NOCOLOR, textcolor = txtCol, size = mapSize)
    // Bullish order block: the last down-close candle at the pullback low before the break
    int window = math.max(1, math.min(bar_index - swHighBar, obScan))
    [idx, ext] = scanExtreme(true, window)
    int   k     = obCandle(true, idx)
    float obTop = obRangeType == "Wick" ? high[k] : math.max(open[k], close[k])
    float obBtm = obRangeType == "Wick" ? low[k] : math.min(open[k], close[k])
    float cap   = obMaxAtr * atr
    if obTop - obBtm > cap and obRangeType == "Wick"
        obTop := math.max(open[k], close[k])
        obBtm := math.min(open[k], close[k])
    bool dispOK = not obNeedDisp or hasFvgSince(true, k) or body > avgBody * 1.5
    if showOB and obTop > obBtm and obTop - obBtm <= cap and dispOK and not bullOBs.overlaps(obTop, obBtm)
        bullOBs.unshift(newZone(bar_index - k, obTop, obBtm, obBullFill, color.new(bullColor, 50), "Bull OB"))
    // New bullish leg: from the pullback low to the breaking high
    legDir     := 1
    legLow     := ext
    legLowBar  := bar_index - idx
    legHigh    := high
    legHighBar := bar_index

if swLowActive and not na(swLow) and bearBreakPx < swLow
    swLowActive := false
    bool choch = trend == 1
    trend            := -1
    lastBearBreakBar := bar_index
    evBearCHoCH      := choch
    evBearBOS        := not choch
    if showStruct
        line.new(swLowBar, swLow, bar_index, swLow, color = color.new(bearColor, 25), style = choch ? line.style_dashed : line.style_solid, width = lineW)
        label.new(int((swLowBar + bar_index) / 2), swLow, choch ? "CHoCH" : "BOS", style = label.style_label_up, color = NOCOLOR, textcolor = txtCol, size = mapSize)
    // Bearish order block: the last up-close candle at the pullback high before the break
    int window = math.max(1, math.min(bar_index - swLowBar, obScan))
    [idx, ext] = scanExtreme(false, window)
    int   k     = obCandle(false, idx)
    float obTop = obRangeType == "Wick" ? high[k] : math.max(open[k], close[k])
    float obBtm = obRangeType == "Wick" ? low[k] : math.min(open[k], close[k])
    float cap   = obMaxAtr * atr
    if obTop - obBtm > cap and obRangeType == "Wick"
        obTop := math.max(open[k], close[k])
        obBtm := math.min(open[k], close[k])
    bool dispOK = not obNeedDisp or hasFvgSince(false, k) or body > avgBody * 1.5
    if showOB and obTop > obBtm and obTop - obBtm <= cap and dispOK and not bearOBs.overlaps(obTop, obBtm)
        bearOBs.unshift(newZone(bar_index - k, obTop, obBtm, obBearFill, color.new(bearColor, 50), "Bear OB"))
    // New bearish leg: from the pullback high to the breaking low
    legDir     := -1
    legHigh    := ext
    legHighBar := bar_index - idx
    legLow     := low
    legLowBar  := bar_index

// ─────────────────────────────────────────────────────────────────────────────
// Fair value gaps
// ─────────────────────────────────────────────────────────────────────────────
bool bullGap = low > high[2] and (low - high[2]) >= atr * fvgMinAtr
bool bearGap = high < low[2] and (low[2] - high) >= atr * fvgMinAtr

if showFVG and bullGap and not bullFVGs.overlaps(low, high[2])
    bullFVGs.unshift(newZone(bar_index - 2, low, high[2], fvgBullFill, color.new(#2962FF, 60), "FVG"))
if showFVG and bearGap and not bearFVGs.overlaps(low[2], high)
    bearFVGs.unshift(newZone(bar_index - 2, low[2], high, fvgBearFill, color.new(#FF9800, 60), "FVG"))

bullOBs.trim(obMax)
bearOBs.trim(obMax)
bullFVGs.trim(fvgMax)
bearFVGs.trim(fvgMax)

// Taps and invalidation
[bullOBTap, bullOBTop, bullOBBtm]    = bullOBs.update(true, false, obKeepBroken)
[bearOBTap, bearOBTop, bearOBBtm]    = bearOBs.update(false, false, obKeepBroken)
[bullFVGTap, bullFVGTop, bullFVGBtm] = bullFVGs.update(true, true, false)
[bearFVGTap, bearFVGTop, bearFVGBtm] = bearFVGs.update(false, true, false)

// ─────────────────────────────────────────────────────────────────────────────
// Fibonacci OTE zone & premium / discount on the current leg
// ─────────────────────────────────────────────────────────────────────────────
float legRange = legHigh - legLow
bool  fibValid = legDir != 0 and legRange > 0
float gzA      = fibValid ? fibLevel(legHigh, legLow, legDir, gzStart) : na
float gzB      = fibValid ? fibLevel(legHigh, legLow, legDir, gzEnd) : na
float gzTop    = math.max(gzA, gzB)
float gzBot    = math.min(gzA, gzB)
float eqLeg    = fibValid ? (legHigh + legLow) / 2 : na

bool inGZBull   = fibValid and legDir == 1 and low <= gzTop and close >= gzBot
bool inGZBear   = fibValid and legDir == -1 and high >= gzBot and close <= gzTop
bool inDiscount = fibValid and close < eqLeg
bool inPremium  = fibValid and close > eqLeg

// ─────────────────────────────────────────────────────────────────────────────
// Higher-timeframe bias (non-repainting: last closed HTF bar) & killzones
// ─────────────────────────────────────────────────────────────────────────────
int htfTrend = request.security(syminfo.tickerid, htfTf, htfTrendCalc(htfLen)[1], lookahead = barmerge.lookahead_on)

bool inKZ = not na(time(timeframe.period, kzLondon, kzTz)) or not na(time(timeframe.period, kzNY, kzTz))
bgcolor(showKZ and inKZ ? color.new(color.gray, 94) : na, title = "Killzone")

// ─────────────────────────────────────────────────────────────────────────────
// Trade management: advance every live trade by one bar
// ─────────────────────────────────────────────────────────────────────────────
var int   statTrades = 0
var int   statWins   = 0
var int   statLosses = 0
var float statNetR   = 0.0

bool evFilled = false
bool evTp1    = false
bool evTp2    = false
bool evSl     = false
bool evMissed = false
int  liveCount = 0

for t in trades
    if t.state != 2
        string ev = t.step()
        evFilled := evFilled or ev == "filled"
        evTp1    := evTp1 or ev == "tp1"
        evTp2    := evTp2 or ev == "tp2"
        evSl     := evSl or ev == "sl"
        evMissed := evMissed or ev == "missed" or ev == "expired"
    if t.state != 2
        t.extendTo(bar_index + 8)
        liveCount += 1
    if t.state == 2 and not t.counted
        t.counted := true
        if t.filled
            statTrades += 1
            statNetR   += t.result
            if t.result > 0
                statWins += 1
            else if t.result < 0
                statLosses += 1

// ─────────────────────────────────────────────────────────────────────────────
// Entry model & confluence scoring
// ─────────────────────────────────────────────────────────────────────────────
// Sweep → Shift: liquidity taken on one side, then structure broken the other way, both recent
bool modelB = not na(lastBullSweep) and not na(lastBullBreakBar) and lastBullBreakBar >= lastBullSweep and lastBullBreakBar - lastBullSweep <= modelWindow and bar_index - lastBullBreakBar <= modelWindow
bool modelS = not na(lastBearSweep) and not na(lastBearBreakBar) and lastBearBreakBar >= lastBearSweep and lastBearBreakBar - lastBearSweep <= modelWindow and bar_index - lastBearBreakBar <= modelWindow

int totalF = 7 + (useHtf ? 1 : 0) + (useKZ ? 1 : 0)

bool fKZ = useKZ and inKZ

bool fTrendB  = trend == 1
bool fOBB     = bullOBTap
bool fFVGB    = bullFVGTap
bool fGZB     = inGZBull
bool fDiscB   = inDiscount
bool fCandleB = bullCandle
bool fSweepB  = bullSweep
bool fHtfB    = useHtf and htfTrend == 1

bool fTrendS  = trend == -1
bool fOBS     = bearOBTap
bool fFVGS    = bearFVGTap
bool fGZS     = inGZBear
bool fPremS   = inPremium
bool fCandleS = bearCandle
bool fSweepS  = bearSweep
bool fHtfS    = useHtf and htfTrend == -1

int scoreB = (fTrendB ? 1 : 0) + (fOBB ? 1 : 0) + (fFVGB ? 1 : 0) + (fGZB ? 1 : 0) + (fDiscB ? 1 : 0) + (fCandleB ? 1 : 0) + (fSweepB ? 1 : 0) + (fHtfB ? 1 : 0) + (fKZ ? 1 : 0)
int scoreS = (fTrendS ? 1 : 0) + (fOBS ? 1 : 0) + (fFVGS ? 1 : 0) + (fGZS ? 1 : 0) + (fPremS ? 1 : 0) + (fCandleS ? 1 : 0) + (fSweepS ? 1 : 0) + (fHtfS ? 1 : 0) + (fKZ ? 1 : 0)

bool poiB = fOBB or fFVGB or fGZB
bool poiS = fOBS or fFVGS or fGZS

// ─────────────────────────────────────────────────────────────────────────────
// Trade planning: liquidity-based targets, market vs limit execution
// ─────────────────────────────────────────────────────────────────────────────
// [risk, TP1, TP2, R:R to TP1, stop] for an entry price and structural stop.
planTrade(int dir, float entry, float slStruct) =>
    // Stop at least minSlPips away from entry
    float slPx = dir == 1 ? math.min(slStruct, entry - minSlPips * PIP) : math.max(slStruct, entry + minSlPips * PIP)
    float risk = dir == 1 ? entry - slPx : slPx - entry
    float tp1  = na
    float tp2  = na
    if risk > 0
        float minT1 = entry + dir * risk * tp1MinR
        // TP1: nearest resting liquidity (pool or the current leg extreme) at least tp1MinR away
        float c1   = dir == 1 ? nearestPool(bslPools, minT1, true) : nearestPool(sslPools, minT1, false)
        float legT = dir == 1 ? (legDir == 1 and fibValid ? legHigh : na) : (legDir == -1 and fibValid ? legLow : na)
        if not na(legT) and dir * (legT - minT1) >= 0
            c1 := na(c1) ? legT : (dir == 1 ? math.min(c1, legT) : math.max(c1, legT))
        tp1 := na(c1) ? entry + dir * risk * 2 : c1
        // TP2: next pool beyond TP1, else the Fibonacci extension, else +1R beyond TP1
        float c2  = dir == 1 ? nearestPool(bslPools, tp1 + risk * 0.5, true) : nearestPool(sslPools, tp1 - risk * 0.5, false)
        float ext = fibValid and legDir == dir ? fibLevel(legHigh, legLow, legDir, -extLevel) : na
        tp2 := not na(c2) ? c2 : (not na(ext) and dir * (ext - tp1) > 0 ? ext : tp1 + dir * risk)
        // Keep targets realistic
        if dir * (tp1 - entry) > maxTp1R * risk
            tp1 := entry + dir * maxTp1R * risk
        float cap2 = entry + dir * math.max(maxTp2R, maxTp1R + 0.5) * risk
        if dir * (tp2 - cap2) > 0
            tp2 := cap2
        if dir * (tp2 - tp1) < risk * 0.5
            tp2 := tp1 + dir * risk * 0.5
    float rr = risk > 0 ? math.abs(tp1 - entry) / risk : 0.0
    [risk, tp1, tp2, rr, slPx]

// Entry zone: the tapped OB first, then FVG, then OTE zone, else the signal candle
float zTopB = fOBB ? bullOBTop : fFVGB ? bullFVGTop : fGZB ? gzTop : math.max(open, close)
float zBtmB = fOBB ? bullOBBtm : fFVGB ? bullFVGBtm : fGZB ? gzBot : low
float zTopS = fOBS ? bearOBTop : fFVGS ? bearFVGTop : fGZS ? gzTop : high
float zBtmS = fOBS ? bearOBBtm : fFVGS ? bearFVGBtm : fGZS ? gzBot : math.min(open, close)

// Optimal limit price inside the zone
float midB = (zTopB + zBtmB) / 2
float oteB = fibValid and legDir == 1 ? fibLevel(legHigh, legLow, 1, 0.705) : midB
float limB = math.max(math.min(limitAt == "Proximal edge" ? zTopB : limitAt == "50% of zone" ? midB : oteB, close), zBtmB)
float midS = (zTopS + zBtmS) / 2
float oteS = fibValid and legDir == -1 ? fibLevel(legHigh, legLow, -1, 0.705) : midS
float limS = math.min(math.max(limitAt == "Proximal edge" ? zBtmS : limitAt == "50% of zone" ? midS : oteS, close), zTopS)

// Stops sit beyond the zone, the signal candle and the sweep wick (where the stop hunt happened)
float slB = math.min(zBtmB, low, bullSweep ? lastBullSweepPx : low) - atr * slAtrBuf
float slS = math.max(zTopS, high, bearSweep ? lastBearSweepPx : high) + atr * slAtrBuf

[riskBM, tp1BM, tp2BM, rrBM, slBM] = planTrade(1, close, slB)
[riskBL, tp1BL, tp2BL, rrBL, slBL] = planTrade(1, limB, slB)
[riskSM, tp1SM, tp2SM, rrSM, slSM] = planTrade(-1, close, slS)
[riskSL, tp1SL, tp2SL, rrSL, slSL] = planTrade(-1, limS, slS)

// Market when price is still at the optimal price and R:R holds; otherwise wait with a limit
bool nearB = close - limB <= mktTolAtr * atr
bool nearS = limS - close <= mktTolAtr * atr
bool mktB  = entryMode == "Market only" or (entryMode == "Auto (market or limit)" and nearB and rrBM >= minRR)
bool mktS  = entryMode == "Market only" or (entryMode == "Auto (market or limit)" and nearS and rrSM >= minRR)

float entB  = mktB ? close : limB
float riskB = mktB ? riskBM : riskBL
float tp1B  = mktB ? tp1BM : tp1BL
float tp2B  = mktB ? tp2BM : tp2BL
float rrB   = mktB ? rrBM : rrBL
float sFinB = mktB ? slBM : slBL
float entS  = mktS ? close : limS
float riskS = mktS ? riskSM : riskSL
float tp1S  = mktS ? tp1SM : tp1SL
float tp2S  = mktS ? tp2SM : tp2SL
float rrS   = mktS ? rrSM : rrSL
float sFinS = mktS ? slSM : slSL

var int lastBuyBar  = na
var int lastSellBar = na

bool slotFree = not oneTrade or liveCount == 0
bool buyRaw   = barstate.isconfirmed and slotFree and (not modelOn or modelB) and (not reqTrend or fTrendB) and (not reqPOI or poiB) and (not reqCandle or fCandleB) and scoreB >= minScore and riskB > 0 and rrB >= minRR and (na(lastBuyBar) or bar_index - lastBuyBar > cooldown)
bool sellRaw  = barstate.isconfirmed and slotFree and (not modelOn or modelS) and (not reqTrend or fTrendS) and (not reqPOI or poiS) and (not reqCandle or fCandleS) and scoreS >= minScore and riskS > 0 and rrS >= minRR and (na(lastSellBar) or bar_index - lastSellBar > cooldown)
bool buySignal  = buyRaw and not sellRaw
bool sellSignal = sellRaw and not buyRaw

// ─────────────────────────────────────────────────────────────────────────────
// Plain-language explanations
// ─────────────────────────────────────────────────────────────────────────────
// Name the liquidity at a target price (EQH / BSL / EQL / SSL) or "" if none.
poolTag(array<Pool> pools, float price, bool buySide) =>
    string tag = ""
    for p in pools
        if p.price == price
            tag := p.eq ? (buySide ? "equal highs" : "equal lows") : (buySide ? "an old high" : "an old low")
    tag

// Reasons to take the trade: only the factors that are true, one short line each.
reasons(bool up, bool fTr, bool fSw, bool fOb, bool fFvg, bool fGz, bool fPd, bool fC, string pat, bool fH, bool fK) =>
    string s = ""
    int    n = 0
    if fTr
        s += "• Trend: price broke " + (up ? "above a recent high,\n   so buyers are in control" : "below a recent low,\n   so sellers are in control") + "\n"
        n += 1
    if fSw
        s += "• Stop hunt: price " + (up ? "dipped under an old low\n   to grab stop losses, then bounced" : "spiked above an old high\n   to grab stop losses, then dropped") + "\n"
        n += 1
    if fOb
        s += "• Order block: price came back to the last\n   " + (up ? "selling candle before a strong rise" : "buying candle before a strong drop") + "\n"
        n += 1
    if fFvg
        s += "• Fair value gap: price filled a gap left\n   by a fast move " + (up ? "up" : "down") + "\n"
        n += 1
    if fGz
        s += "• Pullback: price retraced 62–79% of the\n   last move (the best-value zone)\n"
        n += 1
    if fPd
        s += "• Price: in the " + (up ? "cheap (discount) half of the range,\n   a good place to buy" : "expensive (premium) half of the range,\n   a good place to sell") + "\n"
        n += 1
    if fC
        s += "• Candle: " + pat + " —\n   " + patMeaning(pat) + "\n"
        n += 1
    if fH
        s += "• Bigger picture: the " + htfTf + " chart agrees\n"
        n += 1
    if fK
        s += "• Timing: inside the London / New York session\n"
        n += 1
    [s, n]

// The trade plan in plain words.
planText(bool up, bool mkt, float entry, float sl, float tp1, float tp2) =>
    string side = up ? "Buy" : "Sell"
    string s = mkt ? side + " now at " + px(entry) + ".\n" : "Place a " + str.upper(side) + " LIMIT at " + px(entry) + " (" + fmtPips(entry - close) + " from price).\n   Cancel it if not filled within " + str.tostring(limitExpiry) + " bars,\n   or if price reaches Target 1 first.\n"
    s += "Stop loss at " + px(sl) + " (" + fmtPips(entry - sl) + ") — " + (up ? "below" : "above") + " the zone" + (minSlPips > 0 ? ",\n   never closer than " + str.tostring(minSlPips) + " pips" : "") + ".\n   If price gets there, the idea is wrong.\n"
    s += tp1Pct >= 100 ? "Close everything at Target 1 " + px(tp1) + "." : "Take " + str.tostring(tp1Pct) + "% at Target 1 " + px(tp1) + (beAfterTp1 ? ",\n   then move the stop to entry (no-loss trade)" : "") + ";\n   let the rest run to Target 2 " + px(tp2) + "."
    s

// ─────────────────────────────────────────────────────────────────────────────
// Signals
// ─────────────────────────────────────────────────────────────────────────────
string alertText = ""

if buySignal or sellSignal
    bool   up    = buySignal
    bool   mkt   = up ? mktB : mktS
    float  ent   = up ? entB : entS
    float  sl    = up ? sFinB : sFinS
    float  tp1   = up ? tp1B : tp1S
    float  tp2   = up ? tp2B : tp2S
    float  rr    = up ? rrB : rrS
    int    sc    = up ? scoreB : scoreS
    [why, n] = reasons(up, up ? fTrendB : fTrendS, up ? fSweepB : fSweepS, up ? fOBB : fOBS, up ? fFVGB : fFVGS, up ? fGZB : fGZS, up ? fDiscB : fPremS, up ? fCandleB : fCandleS, up ? bullPat : bearPat, up ? fHtfB : fHtfS, fKZ)
    string plan  = planText(up, mkt, ent, sl, tp1, tp2)
    string side  = (up ? "BUY " : "SELL ") + (mkt ? "MARKET" : "LIMIT")
    string pat   = up ? bullPat : bearPat
    float  zT    = up ? zTopB : zTopS
    float  zB    = up ? zBtmB : zBtmS
    int    expT  = time + limitExpiry * TFMS
    float  risk  = math.abs(ent - sl)
    float  r2    = risk > 0 ? math.abs(tp2 - ent) / risk : 0.0
    if up
        lastBuyBar := bar_index
    else
        lastSellBar := bar_index
    if pat != ""
        markPattern(pat, up, false)
    label.new(bar_index, up ? low : high, (up ? "▲ " : "▼ ") + side + "\n" + px(ent) + (pat != "" ? "\n" + pat : ""), yloc = up ? yloc.belowbar : yloc.abovebar, style = up ? label.style_label_up : label.style_label_down, color = up ? bullColor : bearColor, textcolor = txtCol, size = tradeSize, tooltip = side + "  ·  " + syminfo.ticker + " " + tfName() + "\n\nWhy (" + str.tostring(n) + " reasons):\n" + why + "\nPlan:\n" + plan)
    Trade nt = newTrade(up ? 1 : -1, mkt, ent, sl, tp1, tp2, zT, zB, expT)
    nt.score := sc
    nt.total := totalF
    nt.why   := why
    nt.plan  := plan
    trades.unshift(nt)
    string when  = str.format_time(time, "dd MMM yyyy HH:mm", syminfo.timezone)
    string whenX = str.format_time(expT, "dd MMM yyyy HH:mm", syminfo.timezone)
    // One clean block with everything, ready to paste anywhere
    string share = (up ? "▲ " : "▼ ") + side + " — " + syminfo.ticker + " " + tfName() + "\n"
    share += "Entry: " + px(ent) + (mkt ? "  (market order, " + when + ")" : "  (limit order, placed " + when + ", valid until " + whenX + ")") + "\n"
    share += "Stop loss: " + px(sl) + "  (-" + fmtPips(ent - sl) + ")\n"
    share += "Target 1: " + px(tp1) + "  (+" + fmtPips(tp1 - ent) + ", " + str.tostring(rr, "#.#") + "R)\n"
    share += "Target 2: " + px(tp2) + "  (+" + fmtPips(tp2 - ent) + ", " + str.tostring(r2, "#.#") + "R)\n"
    share += "\nWhy:\n" + why + "\nPlan:\n" + plan
    log.info(share)
    alertText := alertFormat == "Plain text" ? share : "{\"action\":\"" + (up ? "buy" : "sell") + "\",\"order\":\"" + (mkt ? "market" : "limit") + "\",\"symbol\":\"" + syminfo.ticker + "\",\"timeframe\":\"" + timeframe.period + "\",\"entry\":" + px(ent) + ",\"sl\":" + px(sl) + ",\"tp1\":" + px(tp1) + ",\"tp2\":" + px(tp2) + ",\"tp1_close_pct\":" + str.tostring(tp1Pct) + ",\"move_sl_to_be\":" + (beAfterTp1 ? "true" : "false") + ",\"expiry_bars\":" + str.tostring(limitExpiry) + ",\"time\":\"" + when + "\"}"

// Keep only the newest finished trades on the chart (live trades are never removed)
int closedN = 0
for t in trades
    if t.state == 2
        closedN += 1
int excess = closedN - keepSetups
if excess > 0 and trades.size() > 0
    for i = trades.size() - 1 to 0
        if excess > 0
            Trade t = trades.get(i)
            if t.state == 2
                t.erase()
                trades.remove(i)
                excess -= 1

// Candlestick patterns: box the exact candles and name the pattern (signal bars already show both)
bool showBullPat = candleMode != "Off" and bullCandle and not buySignal and (candleMode == "All" or poiB or bar_index == lastBullSweep)
bool showBearPat = candleMode != "Off" and bearCandle and not sellSignal and (candleMode == "All" or poiS or bar_index == lastBearSweep)
if showBullPat
    markPattern(bullPat, true, true)
if showBearPat
    markPattern(bearPat, false, true)

// ─────────────────────────────────────────────────────────────────────────────
// Last-bar drawings: Fibonacci, OTE zone, premium / discount, expected path
// ─────────────────────────────────────────────────────────────────────────────
var array<float> FIB_LEVELS = array.from(0.0, 0.5, 0.618, 0.705, 0.786, 1.0)
var polyline     pathLine   = na

// One market leg from y0 to y1 over n bars: push 60% of the way, pull back to 35%, then finish.
// Returns the end point.
addLeg(array<chart.point> pts, int x0, float y0, float y1, int n) =>
    float d = y1 - y0
    pts.push(chart.point.from_index(x0 + int(math.round(n * 0.35)), y0 + d * 0.6))
    pts.push(chart.point.from_index(x0 + int(math.round(n * 0.55)), y0 + d * 0.35))
    pts.push(chart.point.from_index(x0 + n, y1))
    [x0 + n, y1]
var array<line>  lastLines  = array.new<line>()
var array<label> lastLabels = array.new<label>()
var array<box>   lastBoxes  = array.new<box>()

if barstate.islast
    for l in lastLines
        l.delete()
    lastLines.clear()
    for lb in lastLabels
        lb.delete()
    lastLabels.clear()
    for b in lastBoxes
        b.delete()
    lastBoxes.clear()

    if fibValid
        int x1 = math.min(legLowBar, legHighBar)
        int xe = bar_index + 15
        if showFib
            for r in FIB_LEVELS
                float p = fibLevel(legHigh, legLow, legDir, r)
                lastLines.push(line.new(x1, p, xe, p, color = color.new(fibColor, r == 0.5 ? 30 : 60), style = r == 0.0 or r == 1.0 ? line.style_solid : line.style_dotted, width = 1))
                string nm = r == 0.5 ? "0.5 EQ" : str.tostring(r)
                lastLabels.push(label.new(xe, p, nm + "  " + px(p), style = label.style_label_left, color = NOCOLOR, textcolor = txtCol, size = mapSize))
            lastBoxes.push(box.new(x1, gzTop, xe, gzBot, border_color = color.new(#FFD600, 80), border_width = 1, bgcolor = gzFill, text = "OTE", text_size = mapSize, text_color = txtCol, text_halign = text.align_left))
        if showPD
            lastBoxes.push(box.new(x1, legHigh, xe, eqLeg, border_color = NOCOLOR, bgcolor = color.new(bearColor, 95), text = "Premium", text_size = mapSize, text_color = txtCol, text_halign = text.align_right, text_valign = text.align_top))
            lastBoxes.push(box.new(x1, eqLeg, xe, legLow, border_color = NOCOLOR, bgcolor = color.new(bullColor, 95), text = "Discount", text_size = mapSize, text_color = txtCol, text_halign = text.align_right, text_valign = text.align_bottom))

    // Expected path for the live setup, drawn as market legs (impulse → pullback → impulse).
    // A waiting limit order: price pulls back into the entry first, marked on the path.
    if not na(pathLine)
        pathLine.delete()
    if showPath and trades.size() > 0
        Trade t = trades.get(0)
        if t.state != 2
            array<chart.point> pts = array.new<chart.point>()
            pts.push(chart.point.from_index(bar_index, close))
            int   x = bar_index
            float y = close
            if t.state == 0
                [xa, ya] = addLeg(pts, x, y, t.entry, 6)
                x := xa
                y := ya
                lastLabels.push(label.new(x, t.entry, "● LIMIT ENTRY  " + px(t.entry), style = label.style_label_left, color = entryColor, textcolor = color.black, size = tradeSize, tooltip = "The path expects price to come back to the limit at " + px(t.entry) + " before moving to the targets"))
            if not t.tp1Hit
                [xb, yb] = addLeg(pts, x, y, t.tp1, 10)
                x := xb
                y := yb
                lastLabels.push(label.new(x, t.tp1, "TP1", style = t.dir == 1 ? label.style_label_down : label.style_label_up, color = color.new(tpColor, 20), textcolor = color.black, size = mapSize))
            [xc, yc] = addLeg(pts, x, y, t.tp2, 10)
            lastLabels.push(label.new(xc, t.tp2, "TP2", style = t.dir == 1 ? label.style_label_down : label.style_label_up, color = color.new(tpColor, 40), textcolor = color.black, size = mapSize))
            pathLine := polyline.new(pts, curved = false, line_color = pathColor, line_style = line.style_arrow_right, line_width = 2)
            lastLabels.push(label.new(bar_index, close, t.state == 0 ? "Expected path: pullback to entry, then targets" : "Expected path to targets", style = t.dir == 1 ? label.style_label_up : label.style_label_down, color = color.new(pathColor, 10), textcolor = color.black, size = mapSize))

// ─────────────────────────────────────────────────────────────────────────────
// Trade card: the latest setup in full, in plain language
// ─────────────────────────────────────────────────────────────────────────────
cardPos = switch cardPosIn
    "Top right"    => position.top_right
    "Top left"     => position.top_left
    "Bottom left"  => position.bottom_left
    "Middle right" => position.middle_right
    => position.bottom_right

var table card = table.new(cardPos, 3, 9, bgcolor = color.new(#0B0E14, 0), border_color = color.new(color.gray, 75), border_width = 1, frame_color = color.new(color.gray, 50), frame_width = 1)

cardRow(int r, string k, string v1, string v2) =>
    table.cell(card, 0, r, k, text_color = txtCol, text_size = cardSize, text_halign = text.align_left, text_valign = text.align_top)
    table.cell(card, 1, r, v1, text_color = txtCol, text_size = cardSize, text_halign = text.align_left, text_valign = text.align_top)
    table.cell(card, 2, r, v2, text_color = txtCol, text_size = cardSize, text_halign = text.align_left, text_valign = text.align_top)

if barstate.islast and showCard
    table.clear(card, 0, 0, 2, 8)
    float  winRate = statTrades > 0 ? statWins * 100.0 / statTrades : 0.0
    string record  = str.tostring(statTrades) + " trades · " + str.tostring(winRate, "#") + "% won · " + (statNetR >= 0 ? "+" : "") + str.tostring(statNetR, "#.#") + "R"
    if trades.size() == 0
        cardRow(0, "SMC Confluence Mapper", syminfo.ticker + " · " + tfName(), "")
        cardRow(1, "Status", "Waiting for a setup", "")
        cardRow(2, "Track record", record, "on this chart")
    else
        Trade t      = trades.get(0)
        bool  up     = t.dir == 1
        color dc     = up ? bullColor : bearColor
        float risk   = math.abs(t.entry - t.slInit)
        float r1     = risk > 0 ? math.abs(t.tp1 - t.entry) / risk : 0.0
        float r2     = risk > 0 ? math.abs(t.tp2 - t.entry) / risk : 0.0
        string side  = (up ? "▲ BUY " : "▼ SELL ") + (t.isMarket ? "MARKET" : "LIMIT")
        string status = t.state == 0 ? "Waiting for fill" : t.state == 1 ? (t.tp1Hit ? "Running · TP1 hit" : "Running") : t.filled ? t.outcome + "  " + (t.result >= 0 ? "+" : "") + str.tostring(t.result, "#.##") + "R" : "Limit " + str.lower(t.outcome)
        color stCol  = t.state == 2 and t.filled ? (t.result > 0 ? tpColor : t.result < 0 ? slColor : color.gray) : t.state == 0 ? entryColor : dc
        cardRow(0, side, syminfo.ticker + " · " + tfName(), status)
        table.cell_set_bgcolor(card, 0, 0, color.new(dc, 10))
        table.cell_set_bgcolor(card, 2, 0, color.new(stCol, 35))
        string fmt    = "dd MMM yyyy HH:mm"
        string eWhen  = t.isMarket ? "Market order · filled " + str.format_time(t.startTime, fmt, syminfo.timezone) : t.state == 0 ? "Limit order · placed " + str.format_time(t.startTime, fmt, syminfo.timezone) + "\nvalid until " + str.format_time(t.expiryTime, fmt, syminfo.timezone) : t.filled ? "Limit order · filled " + str.format_time(t.fillTime, fmt, syminfo.timezone) : "Limit order · " + str.lower(t.outcome)
        cardRow(1, "▶ ENTRY", px(t.entry), eWhen)
        table.cell_set_text_color(card, 0, 1, color.black)
        table.cell_set_text_color(card, 1, 1, color.black)
        table.cell_set_text_color(card, 2, 1, color.black)
        table.cell_set_bgcolor(card, 0, 1, entryColor)
        table.cell_set_bgcolor(card, 2, 1, entryColor)
        cardRow(2, "Stop loss", px(t.slInit), "-" + fmtPips(risk) + "  (-1R)")
        cardRow(3, "Target 1", px(t.tp1), "+" + fmtPips(t.tp1 - t.entry) + "  (" + str.tostring(r1, "#.#") + "R)")
        cardRow(4, "Target 2", px(t.tp2), "+" + fmtPips(t.tp2 - t.entry) + "  (" + str.tostring(r2, "#.#") + "R)")
        cardRow(5, "Why this trade", t.why, str.tostring(t.score) + " / " + str.tostring(t.total) + " factors")
        cardRow(6, "The plan", t.plan, "")
        cardRow(7, "Track record", record, "on this chart")
        cardRow(8, "Copy this signal", "Pine Logs or Alerts log", "full text, one block")
        table.cell_set_bgcolor(card, 1, 1, entryColor)
        table.cell_set_bgcolor(card, 1, 2, color.new(slColor, 70))
        table.cell_set_bgcolor(card, 1, 3, color.new(tpColor, 70))
        table.cell_set_bgcolor(card, 1, 4, color.new(tpColor, 80))

// ─────────────────────────────────────────────────────────────────────────────
// Data window & alerts
// ─────────────────────────────────────────────────────────────────────────────
plot(scoreB, "Buy confluence score", color = bullColor, display = display.data_window)
plot(scoreS, "Sell confluence score", color = bearColor, display = display.data_window)
plot(fibValid ? gzTop : na, "OTE zone top", color = fibColor, display = display.data_window)
plot(fibValid ? gzBot : na, "OTE zone bottom", color = fibColor, display = display.data_window)

alertcondition(buySignal, "SMC-CM: Buy setup", "SMC-CM BUY setup on {{ticker}} ({{interval}}) at {{close}}")
alertcondition(sellSignal, "SMC-CM: Sell setup", "SMC-CM SELL setup on {{ticker}} ({{interval}}) at {{close}}")
alertcondition(evFilled, "SMC-CM: Limit filled", "SMC-CM limit order filled on {{ticker}} ({{interval}})")
alertcondition(evTp1 or evTp2, "SMC-CM: Take profit hit", "SMC-CM take profit hit on {{ticker}} ({{interval}})")
alertcondition(evSl, "SMC-CM: Stop loss hit", "SMC-CM stop loss hit on {{ticker}} ({{interval}})")
alertcondition(evBullBOS or evBearBOS, "SMC-CM: BOS", "SMC-CM break of structure on {{ticker}} ({{interval}})")
alertcondition(evBullCHoCH or evBearCHoCH, "SMC-CM: CHoCH", "SMC-CM change of character on {{ticker}} ({{interval}})")
alertcondition(bullSweepNow or bearSweepNow, "SMC-CM: Liquidity sweep", "SMC-CM liquidity sweep on {{ticker}} ({{interval}})")

// Full trade plan (plain text to copy and share, or JSON for a webhook bridge)
if alertText != ""
    alert(alertText, alert.freq_once_per_bar_close)
if evFilled
    alert("SMC-CM limit order filled on " + syminfo.ticker + " " + tfName(), alert.freq_once_per_bar_close)
if evTp1
    alert("SMC-CM Target 1 hit on " + syminfo.ticker + " " + tfName() + (beAfterTp1 ? " — move stop to entry" : ""), alert.freq_once_per_bar_close)
if evTp2
    alert("SMC-CM Target 2 hit on " + syminfo.ticker + " " + tfName(), alert.freq_once_per_bar_close)
if evSl
    alert("SMC-CM stop loss hit on " + syminfo.ticker + " " + tfName(), alert.freq_once_per_bar_close)
if evMissed
    alert("SMC-CM limit order cancelled (missed / expired) on " + syminfo.ticker + " " + tfName(), alert.freq_once_per_bar_close)
